[Unit]
Description=CJPayment Enterprise Payment System
Documentation=https://github.com/your-org/cjpayment
After=network.target
Wants=network.target

[Service]
Type=simple
User=cjpayment
Group=cjpayment
WorkingDirectory=/opt/cjpayment
ExecStart=/opt/cjpayment/cjpayment
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=20
Restart=always
RestartSec=5

# 环境变量
Environment=GIN_MODE=release
Environment=PORT=8091

# 安全设置
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/cjpayment/logs
ReadWritePaths=/tmp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cjpayment

[Install]
WantedBy=multi-user.target