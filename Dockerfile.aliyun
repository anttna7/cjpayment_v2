# CJPayment系统阿里云生产环境Dockerfile
FROM golang:1.21-alpine AS builder

# 设置阿里云镜像加速
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# 安装依赖
RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev

# 设置时区为中国
RUN cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app

# 复制go mod文件
COPY go.mod go.sum ./

# 设置Go代理为阿里云
ENV GOPROXY=https://mirrors.aliyun.com/goproxy/,direct
ENV GO111MODULE=on
ENV CGO_ENABLED=1

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 编译应用
RUN go build -ldflags="-w -s" -o cjpayment-app frontend_demo.go

# 运行阶段
FROM alpine:latest

# 设置阿里云镜像加速
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# 安装运行时依赖
RUN apk --no-cache add ca-certificates tzdata curl

# 设置时区
RUN cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && echo "Asia/Shanghai" > /etc/timezone

# 创建应用目录和用户
RUN addgroup -g 1001 -S cjpayment && \
    adduser -u 1001 -S cjpayment -G cjpayment

WORKDIR /app

# 复制编译后的应用
COPY --from=builder /app/cjpayment-app .
COPY --chown=cjpayment:cjpayment web/ web/
COPY --chown=cjpayment:cjpayment internal/ internal/
COPY --chown=cjpayment:cjpayment pkg/ pkg/
COPY --chown=cjpayment:cjpayment configs/ configs/

# 创建日志和数据目录
RUN mkdir -p /app/logs /app/data && \
    chown -R cjpayment:cjpayment /app

# 切换到非root用户
USER cjpayment

# 暴露端口
EXPOSE 8091

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8091/health || exit 1

# 启动应用
CMD ["./cjpayment-app"]