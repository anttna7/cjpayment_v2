<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>商户管理 - CJPayment 企业内部支付管理系统</title>
    
    <!-- 统一主题系统 -->
    <link rel="stylesheet" href="/static/css/theme-unified.css">
    <link rel="stylesheet" href="/static/css/header-unified.css">
    
    <!-- 统一布局样式系统 -->
    <link rel="stylesheet" href="/static/css/layout-unified.css">
    
    <!-- 统一按钮交互样式系统 -->
    <link rel="stylesheet" href="/static/css/buttons-unified.css">
    
    <!-- 页面特定样式 -->
    <link rel="stylesheet" href="/static/css/merchant-management-enhanced.css">
    
    <!-- Header Dropdown 修复 - 解决通知和用户菜单默认打开状态问题 -->
    <link rel="stylesheet" href="/static/css/header-dropdown-fix.css">
    <link rel="stylesheet" href="/static/css/merchant-link-styles.css">
    <link rel="stylesheet" href="/static/css/components/modal-unified.css">
    <link rel="stylesheet" href="/static/css/components/merchant-modal.css">
    
    <!-- Header Fix CSS - 修复通知和个人中心样式 -->
    <link rel="stylesheet" href="/static/css/header-fix.css">
    
    <style>
        /* 域名预览样式 */
        .domain-preview-container {
            margin-bottom: 1rem;
        }
        
        .domain-preview {
            background: var(--account-bg-tertiary);
            border: 2px dashed var(--dashboard-border-primary);
            border-radius: 8px;
            padding: 1rem;
            font-family: monospace;
            font-size: 0.95rem;
            color: var(--dashboard-text-secondary);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .domain-base {
            color: var(--dashboard-text-primary);
            font-weight: 600;
        }
        
        .domain-suffix {
            color: var(--account-primary);
            font-weight: 600;
            background: rgba(59, 130, 246, 0.1);
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
        }
        
        .checkbox-group {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        
        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            font-size: 0.9rem;
        }
        
        .checkbox-custom {
            width: 18px;
            height: 18px;
            border: 2px solid var(--dashboard-border-primary);
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }
        
        input[type="checkbox"]:checked + .checkbox-custom {
            background: var(--account-primary);
            border-color: var(--account-primary);
        }
        
        input[type="checkbox"]:checked + .checkbox-custom::after {
            content: "✓";
            color: white;
            font-size: 12px;
            font-weight: bold;
        }
        
        input[type="checkbox"] {
            display: none;
        }
    </style>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    
    <!-- Meta tags -->
    <meta name="description" content="CJPayment企业内部支付管理系统商户管理">
    <meta name="keywords" content="商户管理,支付管理,企业系统">
</head>
<body class="page-merchant-management" data-page="merchants">
    <!-- Enhanced Navigation Header -->
    <header class="app__header" id="appHeader">
        <div class="header">
            <!-- Logo Section -->
            <div class="header__left">
                <a href="/dashboard" class="logo">
                    <div class="logo__icon">💎</div>
                    <div>
                        <h1 class="logo__text">CJPayment</h1>
                        <span class="logo__version">v2.0</span>
                    </div>
                </a>
            </div>
            
            <!-- Main Navigation -->
            <nav class="nav" id="headerNav" role="navigation" aria-label="主要导航">
                <ul class="nav__list">
                    <li class="nav__item">
                        <a href="/dashboard" class="nav__link" data-route="dashboard">
                            <span class="nav__icon">📊</span>
                            <span class="nav__text">仪表板</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/merchant" class="nav__link nav__link--active" data-route="merchant">
                            <span class="nav__icon">🏪</span>
                            <span class="nav__text">商户管理</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/accounts" class="nav__link" data-route="accounts">
                            <span class="nav__icon">💰</span>
                            <span class="nav__text">账户管理</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/audit" class="nav__link" data-route="audit">
                            <span class="nav__icon">📋</span>
                            <span class="nav__text">财务审核</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/reports" class="nav__link" data-route="reports">
                            <span class="nav__icon">📈</span>
                            <span class="nav__text">数据报表</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/system_management" class="nav__link" data-route="system">
                            <span class="nav__icon">⚙️</span>
                            <span class="nav__text">系统管理</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <!-- Header Right -->
            <div class="header__right">
                <!-- Theme Toggle -->
                <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
                    <span class="theme-icon">🌙</span>
                </button>
                
                <!-- Notifications -->
                <div class="notifications" id="notifications">
                    <button class="notifications__trigger" id="notificationButton" aria-label="通知" title="查看通知">
                        <span class="notifications__icon">🔔</span>
                        <span class="notifications__badge" id="notificationBadge">3</span>
                    </button>
                    <div class="notifications__dropdown" id="notificationsDropdown">
                        <div class="notifications__header">
                            <h4>商户通知</h4>
                            <button class="notifications__clear" id="clearNotifications">全部已读</button>
                        </div>
                        <div class="notifications__list" id="notificationsList">
                            <div class="notification-item notification-unread">
                                <div class="notification-icon unread"></div>
                                <div class="notification-content">
                                    <div class="notification-title">新商户待审核</div>
                                    <div class="notification-text">有2个新商户申请待审核</div>
                                    <div class="notification-meta">
                                        <span class="notification-time">10分钟前</span>
                                        <span class="notification-new">新</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- User Menu -->
                <div class="user-menu" id="userMenu">
                    <button class="user-menu__trigger" id="userButton">
                        <div class="user-menu__avatar">👤</div>
                        <div class="user-menu__info">
                            <span class="user-menu__name">管理员</span>
                            <span class="user-menu__role">超级管理员</span>
                        </div>
                        <span class="user-menu__arrow">▼</span>
                    </button>
                    <div class="user-menu__dropdown" id="userDropdown">
                        <a href="/profile" class="user-menu__item">
                            <span class="user-menu__item-icon">👤</span>
                            个人资料
                        </a>
                        <a href="/settings" class="user-menu__item">
                            <span class="user-menu__item-icon">⚙️</span>
                            账户设置
                        </a>
                        <a href="/help" class="user-menu__item">
                            <span class="user-menu__item-icon">❓</span>
                            帮助中心
                        </a>
                        <div class="user-menu__divider"></div>
                        <a href="/logout" class="user-menu__item user-menu__item--danger">
                            <span class="user-menu__item-icon">🚪</span>
                            退出登录
                        </a>
                    </div>
                </div>
                
                <!-- Mobile Menu Toggle -->
                <button class="nav__toggle" id="mobileMenuToggle">
                    <span class="nav__toggle-line"></span>
                    <span class="nav__toggle-line"></span>
                    <span class="nav__toggle-line"></span>
                </button>
            </div>
        </div>
    </header>

    <!-- Enhanced Main Content -->
    <main class="app__main" id="appMain">
        <div class="merchant-management page-container">
            <!-- 统一的页面头部 -->
            <div class="page__header">
                <div class="page__title">
                    <h1>商户管理</h1>
                    <p class="page__subtitle">管理系统中的所有商户信息、状态和配置</p>
                </div>
                
                <div class="page__actions">
                    <button class="btn btn-outline" id="exportMerchants">
                        <span class="btn__icon">📊</span>
                        导出
                    </button>
                    <button class="btn btn-outline" id="importMerchants">
                        <span class="btn__icon">📥</span>
                        导入
                    </button>
                    <button class="btn btn-secondary" id="pollingConfigBtn">
                        <span class="btn__icon">⚙️</span>
                        轮询配置
                    </button>
                    <button class="btn btn-primary" id="addMerchant">
                        <span class="btn__icon">➕</span>
                        添加商户
                    </button>
                </div>
            </div>

            <!-- 搜索和筛选工具栏 -->
            <div class="toolbar">
                <div class="toolbar__left">
                    <div class="search-container">
                        <span class="search-icon">🔍</span>
                        <input type="text" 
                               class="form-input" 
                               id="merchantSearch" 
                               placeholder="搜索商户名称、ID或联系方式..."
                               aria-label="搜索商户">
                    </div>
                </div>
                <div class="toolbar__right">
                    <select class="form-select" id="statusFilter" aria-label="筛选状态">
                        <option value="">全部状态</option>
                        <option value="active">活跃</option>
                        <option value="inactive">非活跃</option>
                        <option value="pending">待审核</option>
                        <option value="suspended">已暂停</option>
                    </select>
                    <select class="form-select" id="typeFilter" aria-label="筛选类型">
                        <option value="">全部类型</option>
                        <option value="enterprise">企业</option>
                        <option value="individual">个人</option>
                        <option value="government">政府机构</option>
                    </select>
                </div>
            </div>

            <!-- Enhanced Merchant Container -->
            <div class="merchant-container">
                <!-- View Toggle -->
                <div class="view-toggle">
                    <button class="view-toggle__button active" id="gridViewBtn" data-view="grid">
                        <span class="view-icon">⊞</span>
                        卡片视图
                    </button>
                    <button class="view-toggle__button" id="tableViewBtn" data-view="table">
                        <span class="view-icon">☰</span>
                        表格视图
                    </button>
                </div>

                <!-- Grid View -->
                <div class="merchant-grid" id="merchantGrid">
                    <!-- Loading skeletons will be shown initially -->
                    <div class="merchant-card merchant-card--loading">
                        <div class="merchant-card__header">
                            <div class="merchant-card__info">
                                <div class="merchant-card__name loading-skeleton"></div>
                                <div class="merchant-card__id loading-skeleton"></div>
                            </div>
                            <div class="status-badge loading-skeleton" style="width: 60px; height: 24px;"></div>
                        </div>
                        <div class="merchant-card__details">
                            <div class="merchant-detail">
                                <div class="merchant-detail__label">联系人</div>
                                <div class="merchant-detail__value loading-skeleton"></div>
                            </div>
                            <div class="merchant-detail">
                                <div class="merchant-detail__label">创建时间</div>
                                <div class="merchant-detail__value loading-skeleton"></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Repeat loading skeleton cards -->
                    <div class="merchant-card merchant-card--loading">
                        <div class="merchant-card__header">
                            <div class="merchant-card__info">
                                <div class="merchant-card__name loading-skeleton"></div>
                                <div class="merchant-card__id loading-skeleton"></div>
                            </div>
                            <div class="status-badge loading-skeleton" style="width: 60px; height: 24px;"></div>
                        </div>
                        <div class="merchant-card__details">
                            <div class="merchant-detail">
                                <div class="merchant-detail__label">联系人</div>
                                <div class="merchant-detail__value loading-skeleton"></div>
                            </div>
                            <div class="merchant-detail">
                                <div class="merchant-detail__label">创建时间</div>
                                <div class="merchant-detail__value loading-skeleton"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table View -->
                <div class="merchant-table-container" id="merchantTable">
                    <table class="enhanced-table">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" id="selectAll" aria-label="全选">
                                </th>
                                <th>商户信息</th>
                                <th>广告账户ID</th>
                                <th>广告账户名称</th>
                                <th>代理商名称</th>
                                <th>今日充值</th>
                                <th>本月充值</th>
                                <th>状态</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody id="merchantTableBody">
                            <tr>
                                <td colspan="9" class="table__loading">
                                    <div class="loading-spinner"></div>
                                    <span>正在加载商户数据...</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Enhanced Pagination -->
                <div class="pagination-enhanced" id="merchantPagination">
                    <div class="pagination-info">
                        显示 <span id="pageStart">1</span>-<span id="pageEnd">20</span> 条，共 <span id="totalRecords">-</span> 条记录
                    </div>
                    <div class="pagination-controls">
                        <button class="pagination-btn" id="firstPage" disabled>首页</button>
                        <button class="pagination-btn" id="prevPage" disabled>上一页</button>
                        <div class="pagination-numbers" id="paginationNumbers">
                            <!-- 页码将通过JavaScript动态生成 -->
                        </div>
                        <button class="pagination-btn" id="nextPage">下一页</button>
                        <button class="pagination-btn" id="lastPage">末页</button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Enhanced Footer -->
    <footer class="app__footer">
        <div class="footer">
            <div class="footer__left">
                <p class="footer__text">&copy; 2025 CJPayment. All rights reserved.</p>
            </div>
            <div class="footer__right">
                <span class="footer__text">Version 2.0 | Merchant Management</span>
            </div>
        </div>
    </footer>

    <!-- Enhanced Modal for Add/Edit Merchant -->
    <div class="modal-overlay" id="merchantModalOverlay">
        <div class="modal-enhanced modal-large merchant-modal-content" id="merchantModal" role="dialog" aria-labelledby="modalTitle" aria-hidden="true">
            <div class="modal-header">
                    <h2 class="modal-title" id="modalTitle">添加商户</h2>
                    <button class="modal-close" id="modalClose" aria-label="关闭对话框">✕</button>
                </div>
                
                <div class="modal-body">
                    <form id="merchantForm" class="merchant-form">
                        <!-- 基础标识信息 -->
                        <div class="form-section">
                            <h4 class="form-section-title">
                                <span class="section-icon">📋</span>
                                基础标识信息
                            </h4>
                            <p class="form-section-description">设置商户的基本身份信息和代理商关联</p>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="merchantName" class="form-label">
                                        商户名称
                                        <span class="required-mark">*</span>
                                    </label>
                                    <input type="text" 
                                           id="merchantName" 
                                           name="merchantName" 
                                           class="form-input" 
                                           placeholder="请输入商户名称"
                                           required
                                           maxlength="100">
                                    <div class="field-error" id="merchantNameError"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="agentId" class="form-label">
                                        代理商ID
                                        <span class="required-mark">*</span>
                                    </label>
                                    <input type="text" 
                                           id="agentId" 
                                           name="agentId" 
                                           class="form-input" 
                                           placeholder="请输入代理商ID"
                                           required
                                           maxlength="50">
                                    <div class="field-error" id="agentIdError"></div>
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="agentName" class="form-label">
                                        代理商名称
                                        <span class="required-mark">*</span>
                                    </label>
                                    <input type="text" 
                                           id="agentName" 
                                           name="agentName" 
                                           class="form-input" 
                                           placeholder="请输入代理商名称"
                                           required
                                           maxlength="100">
                                    <div class="field-error" id="agentNameError"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="merchantId" class="form-label">商户ID</label>
                                    <div class="input-group">
                                        <input type="text" 
                                               id="merchantId" 
                                               name="merchantId" 
                                               class="form-input" 
                                               placeholder="点击生成商户ID"
                                               readonly>
                                        <button type="button" class="btn-enhanced btn-primary btn-sm" id="generateMerchantIdBtn">
                                            <span class="btn__icon">⚡</span>
                                            生成商户ID
                                        </button>
                                    </div>
                                    <div class="field-help">系统将根据商户名称生成唯一ID</div>
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group" data-field="rechargeDomain">
                                    <label class="form-label">充值域名</label>
                                    <div class="domain-preview-container">
                                        <div class="domain-preview" id="domainPreview">
                                            <span class="domain-base">请先生成商户ID</span>
                                            <span class="domain-suffix" id="domainSuffix"></span>
                                        </div>
                                    </div>
                                    <div class="field-help">充值域名将在生成商户ID时自动创建</div>
                                </div>
                            </div>
                        </div>

                        <!-- 广告账户信息（支持多个） -->
                        <div class="form-section">
                            <div class="form-section-header">
                                <h4 class="form-section-title">
                                    <span class="section-icon">📊</span>
                                    广告账户信息
                                </h4>
                                <button type="button" class="btn-enhanced btn-outline btn-sm" id="addAdAccountBtn">
                                    <span class="btn__icon">➕</span>
                                    添加广告账户
                                </button>
                            </div>
                            <p class="form-section-description">配置商户关联的广告账户，至少需要一个主账户</p>
                            
                            <div id="adAccountsList" class="ad-accounts-list">
                                <!-- 默认的第一个广告账户 -->
                                <div class="ad-account-item" data-account-index="0">
                                    <div class="account-item-header">
                                        <h5 class="account-item-title">广告账户 #1</h5>
                                        <button type="button" class="btn-enhanced btn-ghost btn-sm remove-account-btn" onclick="removeAdAccount(0)" style="display: none;">
                                            <span class="btn__icon">🗑️</span>
                                            移除
                                        </button>
                                    </div>
                                    
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label class="form-label">
                                                广告账户ID
                                                <span class="required-mark">*</span>
                                            </label>
                                            <input type="text" 
                                                   name="adAccounts[0][id]" 
                                                   class="form-input" 
                                                   placeholder="请输入广告账户ID"
                                                   required
                                                   onchange="validateAdAccountBinding(this)">
                                            <div class="field-error"></div>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label class="form-label">
                                                广告账户名称
                                                <span class="required-mark">*</span>
                                            </label>
                                            <input type="text" 
                                                   name="adAccounts[0][name]" 
                                                   class="form-input" 
                                                   placeholder="请输入广告账户名称"
                                                   required
                                                   onchange="validateAdAccountBinding(this)">
                                            <div class="field-error"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 联系信息 -->
                        <div class="form-section">
                            <h4 class="form-section-title">
                                <span class="section-icon">📞</span>
                                联系信息
                            </h4>
                            <p class="form-section-description">设置商户的联系方式，便于业务沟通和问题处理</p>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="contactPerson" class="form-label">联系人</label>
                                    <input type="text" 
                                           id="contactPerson" 
                                           name="contactPerson" 
                                           class="form-input" 
                                           placeholder="请输入联系人姓名"
                                           maxlength="50">
                                    <div class="field-error" id="contactPersonError"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="contactPhone" class="form-label">联系电话</label>
                                    <input type="tel" 
                                           id="contactPhone" 
                                           name="contactPhone" 
                                           class="form-input" 
                                           placeholder="请输入联系电话"
                                           pattern="^1[3-9]\\d{9}$"
                                           maxlength="11">
                                    <div class="field-error" id="contactPhoneError"></div>
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="contactEmail" class="form-label">邮箱地址</label>
                                    <input type="email" 
                                           id="contactEmail" 
                                           name="contactEmail" 
                                           class="form-input" 
                                           placeholder="请输入邮箱地址（可选）"
                                           maxlength="100">
                                    <div class="field-error" id="contactEmailError"></div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="address" class="form-label">联系地址</label>
                                    <input type="text" 
                                           id="address" 
                                           name="address" 
                                           class="form-input" 
                                           placeholder="请输入联系地址（可选）"
                                           maxlength="200">
                                    <div class="field-error" id="addressError"></div>
                                </div>
                            </div>
                        </div>

                        <!-- 商户描述与配置 -->
                        <div class="form-section">
                            <h4 class="form-section-title">
                                <span class="section-icon">📄</span>
                                商户描述与配置
                            </h4>
                            <p class="form-section-description">设置商户的业务描述和初始状态</p>
                            
                            <div class="form-group" data-field="description">
                                <label for="description" class="form-label">商户描述</label>
                                <textarea id="description" 
                                          name="description" 
                                          class="form-textarea" 
                                          rows="4" 
                                          placeholder="请输入商户描述和备注信息（可选）"
                                          maxlength="500"></textarea>
                                <div class="field-help">描述商户的业务范围、特点或其他备注信息</div>
                                <div class="field-counter">
                                    <span class="counter-current">0</span> / <span class="counter-max">500</span>
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="merchantStatus" class="form-label">初始状态</label>
                                    <select id="merchantStatus" 
                                            name="merchantStatus" 
                                            class="form-select">
                                        <option value="pending">待审核</option>
                                        <option value="active" selected>活跃</option>
                                        <option value="inactive">非活跃</option>
                                    </select>
                                    <div class="field-help">选择商户创建后的初始状态</div>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn-enhanced btn-secondary" id="cancelBtn">
                        <span class="btn__text">取消</span>
                    </button>
                    <button type="submit" form="merchantForm" class="btn-enhanced btn-primary" id="saveBtn">
                        <span class="btn__text">保存</span>
                        <span class="btn__loading" style="display: none;">
                            <span class="loading-spinner"></span>
                            保存中...
                        </span>
                    </button>
                </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal-overlay" id="deleteModalOverlay">
        <div class="modal-enhanced modal-small" id="deleteModal" role="dialog" aria-labelledby="deleteModalTitle" aria-hidden="true">
            <div class="modal-header">
                <h2 class="modal-title" id="deleteModalTitle">
                    <span class="modal-title-icon">⚠️</span>
                    确认删除
                </h2>
                <button class="modal-close" id="deleteModalClose" aria-label="关闭对话框">✕</button>
            </div>
            <div class="modal-body simple">
                <p class="modal-description">您确定要删除商户 <strong id="deleteTargetName"></strong> 吗？</p>
                <div class="modal-warning">
                    <span>⚠️</span>
                    <span>此操作不可撤销，请谨慎操作。</span>
                </div>
            </div>
            <div class="modal-footer center">
                <button type="button" class="btn-enhanced btn-outline modal-btn" id="deleteCancelBtn">取消</button>
                <button type="button" class="btn-enhanced btn-danger modal-btn" id="deleteConfirmBtn">
                    <span class="btn__text">确认删除</span>
                    <span class="btn-loading" style="display: none;">
                        <span class="loading-spinner"></span>
                        删除中...
                    </span>
                </button>
            </div>
        </div>
    </div>

    <!-- Merchant Recharge Link Management Modal -->
    <div class="modal-overlay" id="rechargeLinkModalOverlay">
        <div class="modal-enhanced modal-large" id="rechargeLinkModal" role="dialog" aria-labelledby="rechargeLinkModalTitle" aria-hidden="true">
            <div class="modal-header">
                <h2 class="modal-title" id="rechargeLinkModalTitle">
                    <span class="modal-title-icon">🔗</span>
                    商户充值链接管理
                </h2>
                <button class="modal-close" id="rechargeLinkModalClose" aria-label="关闭对话框">✕</button>
            </div>
            <div class="modal-body">
                <!-- 商户基本信息显示 -->
                <div class="merchant-info-display">
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">商户ID：</span>
                            <span class="info-value" id="displayMerchantId">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">商户名称：</span>
                            <span class="info-value" id="displayMerchantName">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">业务类型：</span>
                            <span class="info-value" id="displayBusinessType">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">状态：</span>
                            <span class="info-value" id="displayStatus">-</span>
                        </div>
                    </div>
                </div>
                
                <!-- 充值链接生成区域 -->
                <div class="link-generation-section">
                    <h4 class="section-title">生成充值链接</h4>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label for="linkUtmSource" class="form-label-enhanced">UTM来源</label>
                            <input type="text" 
                                   id="linkUtmSource" 
                                   class="form-input-enhanced" 
                                   placeholder="merchant_portal"
                                   value="merchant_portal">
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label for="linkUtmMedium" class="form-label-enhanced">UTM媒介</label>
                            <input type="text" 
                                   id="linkUtmMedium" 
                                   class="form-input-enhanced" 
                                   placeholder="link"
                                   value="link">
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label for="linkReference" class="form-label-enhanced">引用标识</label>
                            <input type="text" 
                                   id="linkReference" 
                                   class="form-input-enhanced" 
                                   placeholder="可选的引用标识">
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">链接选项</label>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" id="generateShortUrl" checked>
                                    <span class="checkbox-custom"></span>
                                    <span class="checkbox-text">生成短链接</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-actions">
                        <button type="button" class="btn-enhanced btn-primary" id="generateLinkBtn">
                            <span class="btn__icon">🔗</span>
                            生成充值链接
                        </button>
                    </div>
                </div>
                
                <!-- 链接结果显示区域 -->
                <div class="link-result-section" id="linkResultSection" style="display: none;">
                    <h4 class="section-title">生成的充值链接</h4>
                    
                    <div class="link-display-grid">
                        <div class="link-item">
                            <label class="link-label">完整链接：</label>
                            <div class="link-input-group">
                                <input type="text" id="fullUrlDisplay" class="link-input" readonly>
                                <button type="button" class="btn-enhanced btn-outline btn-sm" onclick="copyToClipboard('fullUrlDisplay')">
                                    <span class="btn__icon">📋</span>
                                    复制
                                </button>
                            </div>
                        </div>
                        
                        <div class="link-item" id="shortUrlItem" style="display: none;">
                            <label class="link-label">短链接：</label>
                            <div class="link-input-group">
                                <input type="text" id="shortUrlDisplay" class="link-input" readonly>
                                <button type="button" class="btn-enhanced btn-outline btn-sm" onclick="copyToClipboard('shortUrlDisplay')">
                                    <span class="btn__icon">📋</span>
                                    复制
                                </button>
                            </div>
                        </div>
                        
                        <div class="link-item">
                            <label class="link-label">安全令牌：</label>
                            <div class="link-input-group">
                                <input type="text" id="tokenDisplay" class="link-input" readonly>
                                <button type="button" class="btn-enhanced btn-outline btn-sm" onclick="copyToClipboard('tokenDisplay')">
                                    <span class="btn__icon">📋</span>
                                    复制
                                </button>
                            </div>
                        </div>
                        
                        <div class="link-item">
                            <label class="link-label">有效期至：</label>
                            <div class="link-input-group">
                                <input type="text" id="expiresAtDisplay" class="link-input" readonly>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 二维码显示 -->
                    <div class="qr-code-section">
                        <h5>二维码</h5>
                        <div class="qr-code-container">
                            <div id="qrCodeDisplay" class="qr-code-placeholder">
                                点击"生成二维码"按钮生成二维码
                            </div>
                            <div class="qr-code-actions">
                                <button type="button" class="btn-enhanced btn-outline btn-sm" id="generateQrBtn">
                                    生成二维码
                                </button>
                                <button type="button" class="btn-enhanced btn-outline btn-sm" id="downloadQrBtn" style="display: none;">
                                    下载二维码
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- 链接验证工具 -->
                <div class="link-validation-section">
                    <h4 class="section-title">链接验证工具</h4>
                    
                    <div class="form-group-enhanced">
                        <label for="validateUrl" class="form-label-enhanced">验证链接</label>
                        <div class="validation-input-group">
                            <input type="text" 
                                   id="validateUrl" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入要验证的充值链接">
                            <button type="button" class="btn-enhanced btn-primary" id="validateLinkBtn">
                                验证
                            </button>
                        </div>
                    </div>
                    
                    <div class="validation-result" id="validationResult" style="display: none;">
                        <!-- 验证结果将在这里显示 -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-enhanced btn-outline modal-btn" id="closeLinkModalBtn">关闭</button>
                <button type="button" class="btn-enhanced btn-primary modal-btn" id="copyAllInfoBtn">
                    <span class="btn__text">📋 复制所有信息</span>
                    <span class="btn-loading" style="display: none;">
                        <span class="loading-spinner"></span>
                        复制中...
                    </span>
                </button>
            </div>
        </div>
    </div>

    <!-- Polling Configuration Modal -->
    <div class="modal-overlay" id="pollingConfigModalOverlay">
        <div class="modal-enhanced modal-large" id="pollingConfigModal" role="dialog" aria-labelledby="pollingConfigModalTitle" aria-hidden="true">
            <div class="modal-header">
                <h2 class="modal-title" id="pollingConfigModalTitle">
                    <span class="modal-title-icon">⚙️</span>
                    轮询配置管理
                </h2>
                <button class="modal-close" id="pollingConfigModalClose" aria-label="关闭对话框">✕</button>
            </div>
            <div class="modal-body">
                <form id="pollingConfigForm" class="polling-config-form">
                    <!-- 基础配置信息 -->
                    <div class="form-section">
                        <h4 class="form-section-title">基础配置信息</h4>
                        
                        <div class="form-row">
                            <div class="form-group-enhanced">
                                <label for="pollingRuleName" class="form-label-enhanced required">轮询规则名称</label>
                                <input type="text" 
                                       id="pollingRuleName" 
                                       name="ruleName" 
                                       class="form-input-enhanced" 
                                       placeholder="请输入轮询规则名称"
                                       required
                                       maxlength="50"
                                       aria-describedby="pollingRuleNameError">
                                <div class="form-error" id="pollingRuleNameError"></div>
                            </div>
                            
                            <div class="form-group-enhanced">
                                <label for="pollingDescription" class="form-label-enhanced">规则描述</label>
                                <input type="text" 
                                       id="pollingDescription" 
                                       name="description" 
                                       class="form-input-enhanced" 
                                       placeholder="请输入轮询规则描述（可选）"
                                       maxlength="200">
                            </div>
                        </div>
                    </div>
                    
                    <!-- 收款号配置 -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <h4 class="form-section-title">收款号配置</h4>
                            <button type="button" class="btn btn-outline btn-sm" id="addReceivingAccountBtn">
                                <span class="btn__icon">➕</span>
                                添加收款号
                            </button>
                        </div>
                        
                        <div id="receivingAccountsList" class="receiving-accounts-list">
                            <!-- 默认第一个收款号 -->
                            <div class="receiving-account-item" data-receiving-index="0">
                                <div class="account-item-header">
                                    <h5 class="account-item-title">收款号 #1</h5>
                                    <button type="button" class="btn btn-ghost btn-sm remove-receiving-btn" style="display: none;">
                                        <span class="btn__icon">🗑️</span>
                                        移除
                                    </button>
                                </div>
                                
                                <div class="form-row">
                                    <div class="form-group-enhanced">
                                        <label class="form-label-enhanced required">收款账号</label>
                                        <input type="text" 
                                               name="receivingAccounts[0][account]" 
                                               class="form-input-enhanced" 
                                               placeholder="请输入收款账号"
                                               required>
                                    </div>
                                    
                                    <div class="form-group-enhanced">
                                        <label class="form-label-enhanced">收款账户名称</label>
                                        <input type="text" 
                                               name="receivingAccounts[0][name]" 
                                               class="form-input-enhanced" 
                                               placeholder="请输入收款账户名称（可选）">
                                    </div>
                                </div>
                                
                                <div class="form-row">
                                    <div class="form-group-enhanced">
                                        <label class="form-label-enhanced required">账户类型</label>
                                        <select name="receivingAccounts[0][type]" class="form-select-enhanced" required>
                                            <option value="">请选择账户类型</option>
                                            <option value="bank">银行账户</option>
                                            <option value="alipay">支付宝</option>
                                            <option value="wechat">微信支付</option>
                                            <option value="other">其他</option>
                                        </select>
                                    </div>
                                    
                                    <div class="form-group-enhanced">
                                        <label class="form-label-enhanced">权重</label>
                                        <input type="number" 
                                               name="receivingAccounts[0][weight]" 
                                               class="form-input-enhanced" 
                                               placeholder="1"
                                               value="1"
                                               min="1"
                                               max="100"
                                               title="权重越高，被选中的概率越大">
                                    </div>
                                </div>
                                
                                <div class="form-row">
                                    <div class="form-group-enhanced">
                                        <label class="form-label-enhanced">日限额</label>
                                        <input type="number" 
                                               name="receivingAccounts[0][dailyLimit]" 
                                               class="form-input-enhanced" 
                                               placeholder="0"
                                               min="0"
                                               step="0.01"
                                               title="0表示无限制">
                                    </div>
                                    
                                    <div class="form-group-enhanced">
                                        <label class="form-label-enhanced">单笔限额</label>
                                        <input type="number" 
                                               name="receivingAccounts[0][singleLimit]" 
                                               class="form-input-enhanced" 
                                               placeholder="0"
                                               min="0"
                                               step="0.01"
                                               title="0表示无限制">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 轮询模式配置 -->
                    <div class="form-section">
                        <h4 class="form-section-title">轮询模式配置</h4>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">轮询模式</label>
                            <div class="radio-group">
                                <label class="radio-label">
                                    <input type="radio" name="pollingMode" value="round_robin" checked>
                                    <span class="radio-custom"></span>
                                    <span class="radio-text">
                                        <strong>轮询模式</strong>
                                        <br><small>按顺序依次选择收款账号</small>
                                    </span>
                                </label>
                                <label class="radio-label">
                                    <input type="radio" name="pollingMode" value="random">
                                    <span class="radio-custom"></span>
                                    <span class="radio-text">
                                        <strong>随机模式</strong>
                                        <br><small>随机选择可用的收款账号</small>
                                    </span>
                                </label>
                                <label class="radio-label">
                                    <input type="radio" name="pollingMode" value="weighted">
                                    <span class="radio-custom"></span>
                                    <span class="radio-text">
                                        <strong>权重模式</strong>
                                        <br><small>根据权重比例选择收款账号</small>
                                    </span>
                                </label>
                                <label class="radio-label">
                                    <input type="radio" name="pollingMode" value="load_balance">
                                    <span class="radio-custom"></span>
                                    <span class="radio-text">
                                        <strong>负载均衡</strong>
                                        <br><small>选择当前使用量最低的账号</small>
                                    </span>
                                </label>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group-enhanced">
                                <label for="pollingInterval" class="form-label-enhanced">轮询间隔(秒)</label>
                                <input type="number" 
                                       id="pollingInterval" 
                                       name="interval" 
                                       class="form-input-enhanced" 
                                       placeholder="30"
                                       value="30"
                                       min="1"
                                       max="3600"
                                       title="轮询检查间隔时间">
                            </div>
                            
                            <div class="form-group-enhanced">
                                <label for="maxRetry" class="form-label-enhanced">最大重试次数</label>
                                <input type="number" 
                                       id="maxRetry" 
                                       name="maxRetry" 
                                       class="form-input-enhanced" 
                                       placeholder="3"
                                       value="3"
                                       min="0"
                                       max="10"
                                       title="当收款账号失败时的最大重试次数">
                            </div>
                        </div>
                    </div>
                    
                    <!-- 高级配置 -->
                    <div class="form-section">
                        <h4 class="form-section-title">高级配置</h4>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">配置选项</label>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" name="enableFailover" checked>
                                    <span class="checkbox-custom"></span>
                                    <span class="checkbox-text">启用故障转移</span>
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="enableLimitCheck" checked>
                                    <span class="checkbox-custom"></span>
                                    <span class="checkbox-text">启用限额检查</span>
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="enableLogging">
                                    <span class="checkbox-custom"></span>
                                    <span class="checkbox-text">启用详细日志</span>
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" name="enableNotification">
                                    <span class="checkbox-custom"></span>
                                    <span class="checkbox-text">启用异常通知</span>
                                </label>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-group-enhanced">
                                <label for="effectiveTime" class="form-label-enhanced">生效时间</label>
                                <input type="datetime-local" 
                                       id="effectiveTime" 
                                       name="effectiveTime" 
                                       class="form-input-enhanced">
                            </div>
                            
                            <div class="form-group-enhanced">
                                <label for="expiryTime" class="form-label-enhanced">过期时间</label>
                                <input type="datetime-local" 
                                       id="expiryTime" 
                                       name="expiryTime" 
                                       class="form-input-enhanced">
                            </div>
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label for="pollingRemark" class="form-label-enhanced">备注信息</label>
                            <textarea id="pollingRemark" 
                                      name="remark" 
                                      class="form-input-enhanced" 
                                      placeholder="请输入轮询配置的备注信息（可选）"
                                      rows="3"
                                      maxlength="500"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer space-between">
                <button type="button" class="btn-enhanced btn-outline modal-btn" id="cancelPollingConfigBtn">取消</button>
                <div class="modal-footer-actions">
                    <button type="button" class="btn-enhanced btn-secondary modal-btn" id="previewPollingConfigBtn">
                        <span class="btn__text">👁️ 预览配置</span>
                    </button>
                    <button type="submit" form="pollingConfigForm" class="btn-enhanced btn-primary modal-btn" id="savePollingConfigBtn">
                        <span class="btn__text">保存配置</span>
                        <span class="btn-loading" style="display: none;">
                            <span class="loading-spinner"></span>
                            保存中...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Merchant Import Modal -->
    <div class="modal-overlay" id="importModalOverlay">
        <div class="modal-enhanced modal-large" id="importModal" role="dialog" aria-labelledby="importModalTitle" aria-hidden="true">
            <div class="modal-header">
                <h2 class="modal-title" id="importModalTitle">
                    <span class="modal-title-icon">📄</span>
                    批量导入商户资料
                </h2>
                <button class="modal-close" id="importModalClose" aria-label="关闭对话框">✕</button>
            </div>
            <div class="modal-body">
                <!-- 导入说明 -->
                <div class="import-instructions">
                    <div class="instruction-header">
                        <span class="instruction-icon">📋</span>
                        <h3>导入说明</h3>
                    </div>
                    <div class="instruction-content">
                        <div class="instruction-step">
                            <span class="step-number">1</span>
                            <div class="step-content">
                                <h4>下载模板文件</h4>
                                <p>请先下载标准的商户信息模板文件，按照模板格式填写商户信息</p>
                                <div class="template-actions">
                                    <button type="button" class="btn-enhanced btn-primary btn-sm" id="downloadTemplateBtn">
                                        <span class="btn__icon">📥</span>
                                        下载Excel模板
                                    </button>
                                    <button type="button" class="btn-enhanced btn-outline btn-sm" id="downloadSampleBtn">
                                        <span class="btn__icon">📄</span>
                                        下载样例数据
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <div class="instruction-step">
                            <span class="step-number">2</span>
                            <div class="step-content">
                                <h4>填写商户信息</h4>
                                <p>按照以下格式要求填写商户信息：</p>
                                <div class="format-requirements">
                                    <div class="requirement-group">
                                        <h5>必填字段</h5>
                                        <ul class="requirement-list">
                                            <li><strong>商户名称</strong>：2-50个字符，不能重复</li>
                                            <li><strong>联系人姓名</strong>：2-20个字符</li>
                                            <li><strong>联系电话</strong>：11位手机号或固定电话</li>
                                            <li><strong>商户类型</strong>：个人/企业/机构</li>
                                            <li><strong>账户类型</strong>：对公/对私</li>
                                        </ul>
                                    </div>
                                    <div class="requirement-group">
                                        <h5>可选字段</h5>
                                        <ul class="requirement-list">
                                            <li><strong>商户简介</strong>：不超过200字符</li>
                                            <li><strong>银行名称</strong>：如需绑定银行账户</li>
                                            <li><strong>账户号码</strong>：银行账户号码</li>
                                            <li><strong>开户行</strong>：详细开户行信息</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="instruction-step">
                            <span class="step-number">3</span>
                            <div class="step-content">
                                <h4>上传文件</h4>
                                <p>支持.xlsx、.xls、.csv格式，文件大小不超过10MB，单次最多导入1000条记录</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- 文件上传区域 -->
                <div class="import-upload-section">
                    <div class="upload-area" id="uploadArea">
                        <div class="upload-icon">📁</div>
                        <div class="upload-text">
                            <h4>拖拽文件到此处或点击选择文件</h4>
                            <p>支持 .xlsx, .xls, .csv 格式</p>
                        </div>
                        <input type="file" id="importFileInput" accept=".xlsx,.xls,.csv" style="display: none;">
                        <button type="button" class="btn-enhanced btn-outline" id="selectFileBtn">
                            <span class="btn__icon">📁</span>
                            选择文件
                        </button>
                    </div>
                    
                    <!-- 选中文件信息 -->
                    <div class="selected-file-info" id="selectedFileInfo" style="display: none;">
                        <div class="file-details">
                            <div class="file-icon">📄</div>
                            <div class="file-info">
                                <div class="file-name" id="fileName"></div>
                                <div class="file-meta">
                                    <span class="file-size" id="fileSize"></span>
                                    <span class="file-type" id="fileType"></span>
                                </div>
                            </div>
                            <button type="button" class="remove-file-btn" id="removeFileBtn">✕</button>
                        </div>
                    </div>
                </div>
                
                <!-- 导入选项 -->
                <div class="import-options">
                    <div class="options-header">
                        <h4>导入选项</h4>
                    </div>
                    <div class="options-content">
                        <div class="option-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="skipDuplicates" checked>
                                <span class="checkbox-custom"></span>
                                <span class="checkbox-text">跳过重复商户（基于商户名称）</span>
                            </label>
                        </div>
                        <div class="option-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="validateData" checked>
                                <span class="checkbox-custom"></span>
                                <span class="checkbox-text">启用数据验证（推荐）</span>
                            </label>
                        </div>
                        <div class="option-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="sendNotification">
                                <span class="checkbox-custom"></span>
                                <span class="checkbox-text">导入完成后发送通知</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-enhanced btn-outline modal-btn" id="cancelImportBtn">取消</button>
                <button type="button" class="btn-enhanced btn-primary modal-btn" id="startImportBtn" disabled>
                    <span class="btn__text">📤 开始导入</span>
                    <span class="btn-loading" style="display: none;">
                        <span class="loading-spinner"></span>
                        导入中...
                    </span>
                </button>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="globalLoading" class="loading-overlay" style="display: none;" aria-hidden="true">
        <div class="loading-spinner"></div>
        <p class="loading-text">处理中，请稍候...</p>
    </div>

    <!-- Toast Container -->
    <div id="globalToast" class="toast-container" aria-live="polite"></div>

    <!-- Scripts -->
    <script src="/static/js/utils.js"></script>
    <script src="/static/js/api.js"></script>
    <script src="/static/js/components.js"></script>
    <script src="/static/js/components/enhanced-table.js"></script>
    
    <!-- 统一头部组件管理 -->
    <script src="/static/js/header-unified.js"></script>
    
    <script src="/static/js/merchant-link-manager.js"></script>
    <script src="/static/js/merchant-link-api.js"></script>
    <script src="/static/js/merchant-management-enhanced.js"></script>
    
    <!-- User Analytics & Feedback System -->
    <script src="/static/js/user-feedback-analytics.js"></script>
    <script src="/static/js/analytics-init.js"></script>
    
    <!-- Mobile Utilities -->
    <script src="/static/js/mobile-utilities.js"></script>
    
    <!-- Interaction Enhancements -->
    <script src="/static/js/interaction-enhancements.js"></script>
    
    <!-- Initialize Merchant Management Enhanced -->
    <script>
        // 初始化增强版商户管理系统
        document.addEventListener('DOMContentLoaded', function() {
            // 演示环境认证状态设置
            const authToken = localStorage.getItem('authToken');
            if (!authToken) {
                console.log('Merchant: 演示模式 - 跳过认证检查');
                // 设置默认认证信息用于演示
                localStorage.setItem('authToken', 'demo-token');
                localStorage.setItem('userInfo', JSON.stringify({
                    name: '系统管理员',
                    username: 'admin',
                    role: '超级管理员',
                    id: 'demo_admin'
                }));
            }
            // 确保在DOM加载完成后初始化
            if (window.MerchantManagement) {
                console.log('初始化商户管理系统...');
                window.merchantManager = new window.MerchantManagement();
                console.log('商户管理系统初始化完成');
            } else {
                console.error('MerchantManagement 类未找到');
            }
        });
    </script>
    
    <!-- 多付款账户管理 -->
    <script>
        // 多付款账户管理
        let paymentAccountIndex = 0;
        
        // 切换付款账户银行名称字段显示
        function togglePaymentBankName(selectElement, index) {
            const bankNameRow = document.getElementById(`bankNameRow_${index}`);
            const bankNameSelect = bankNameRow.querySelector('.bank-name-select');
            const manualBankGroup = document.getElementById(`manualBankGroup_${index}`);
            const manualBankInput = manualBankGroup.querySelector('input');
            
            if (selectElement.value === 'bank') {
                // 显示银行名称字段
                bankNameRow.style.display = 'flex';
                
                // 添加平滑显示动画
                bankNameRow.style.opacity = '0';
                bankNameRow.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    bankNameRow.style.transition = 'all 0.3s ease-out';
                    bankNameRow.style.opacity = '1';
                    bankNameRow.style.transform = 'translateY(0)';
                }, 10);
            } else {
                // 隐藏银行名称字段
                bankNameRow.style.display = 'none';
                
                // 清空相关字段的值
                bankNameSelect.value = '';
                manualBankInput.value = '';
                manualBankGroup.style.display = 'none';
            }
        }
        
        // 银行名称选择变化处理
        function handlePaymentBankNameChange(selectElement, index) {
            const manualBankGroup = document.getElementById(`manualBankGroup_${index}`);
            const manualBankInput = manualBankGroup.querySelector('input');
            
            if (selectElement.value === 'manual') {
                // 显示手动输入字段
                manualBankGroup.style.display = 'block';
                manualBankInput.focus();
                
                // 添加平滑显示动画
                manualBankGroup.style.opacity = '0';
                manualBankGroup.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    manualBankGroup.style.transition = 'all 0.3s ease-out';
                    manualBankGroup.style.opacity = '1';
                    manualBankGroup.style.transform = 'translateY(0)';
                }, 10);
            } else {
                // 隐藏手动输入字段
                manualBankGroup.style.display = 'none';
                manualBankInput.value = '';
            }
        }
        
        // 创建新的付款账户项HTML
        function createPaymentAccountItem(index) {
            return `
                <div class="payment-account-item" data-account-index="${index}">
                    <div class="account-item-header">
                        <h5 class="account-item-title">付款账户 #${index + 1}</h5>
                        <button type="button" class="btn btn-ghost btn-sm remove-account-btn" onclick="removePaymentAccount(${index})">
                            <span class="btn__icon">🗑️</span>
                            移除
                        </button>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">付款账户名称</label>
                            <input type="text" 
                                   name="paymentAccounts[${index}][name]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入付款账户名称（可选）">
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">付款账号</label>
                            <input type="text" 
                                   name="paymentAccounts[${index}][account]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入付款账号（可选）">
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">账号类型</label>
                            <select name="paymentAccounts[${index}][businessType]" class="form-select-enhanced">
                                <option value="">请选择账号类型</option>
                                <option value="corporate">对公</option>
                                <option value="personal">对私</option>
                            </select>
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">账户机构</label>
                            <select name="paymentAccounts[${index}][type]" 
                                    class="form-select-enhanced payment-account-type-select"
                                    onchange="togglePaymentBankName(this, ${index})">
                                <option value="">请选择账户机构</option>
                                <option value="bank">银行卡</option>
                                <option value="alipay">支付宝</option>
                                <option value="wechat">微信</option>
                                <option value="other">其它</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- 银行名称字段（当选择银行卡时显示） -->
                    <div class="form-row bank-name-row" id="bankNameRow_${index}" style="display: none;">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">银行名称</label>
                            <select name="paymentAccounts[${index}][bankName]" 
                                    class="form-select-enhanced bank-name-select"
                                    onchange="handlePaymentBankNameChange(this, ${index})">
                                <option value="">请选择银行</option>
                                <option value="icbc">中国工商银行</option>
                                <option value="ccb">中国建设银行</option>
                                <option value="abc">中国农业银行</option>
                                <option value="boc">中国银行</option>
                                <option value="bcom">交通银行</option>
                                <option value="cmb">招商银行</option>
                                <option value="spdb">浦发银行</option>
                                <option value="citic">中信银行</option>
                                <option value="ceb">光大银行</option>
                                <option value="cmbc">民生银行</option>
                                <option value="hxb">华夏银行</option>
                                <option value="pingan">平安银行</option>
                                <option value="cib">兴业银行</option>
                                <option value="manual">手动输入银行名称</option>
                            </select>
                        </div>
                        
                        <div class="form-group-enhanced manual-bank-group" id="manualBankGroup_${index}" style="display: none;">
                            <label class="form-label-enhanced">手动输入银行名称</label>
                            <input type="text" 
                                   name="paymentAccounts[${index}][manualBankName]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入银行名称">
                        </div>
                    </div>
                </div>
            `;
        }
        
        // 添加新的付款账户
        function addPaymentAccount() {
            paymentAccountIndex++;
            const paymentAccountsList = document.getElementById('paymentAccountsList');
            const newAccountItem = document.createElement('div');
            newAccountItem.innerHTML = createPaymentAccountItem(paymentAccountIndex);
            paymentAccountsList.appendChild(newAccountItem.firstElementChild);
            
            // 显示所有移除按钮
            updateRemoveButtons();
            
            // 添加平滑显示动画
            const addedItem = paymentAccountsList.lastElementChild;
            addedItem.style.opacity = '0';
            addedItem.style.transform = 'translateY(-20px)';
            setTimeout(() => {
                addedItem.style.transition = 'all 0.3s ease-out';
                addedItem.style.opacity = '1';
                addedItem.style.transform = 'translateY(0)';
            }, 10);
        }
        
        // 移除付款账户
        function removePaymentAccount(index) {
            const accountItem = document.querySelector(`[data-account-index="${index}"]`);
            if (accountItem) {
                // 添加移除动画
                accountItem.style.transition = 'all 0.3s ease-out';
                accountItem.style.opacity = '0';
                accountItem.style.transform = 'translateX(-100%)';
                
                setTimeout(() => {
                    accountItem.remove();
                    updateRemoveButtons();
                    updateAccountNumbers();
                }, 300);
            }
        }
        
        // 更新移除按钮显示状态
        function updateRemoveButtons() {
            const accountItems = document.querySelectorAll('.payment-account-item');
            const removeButtons = document.querySelectorAll('.remove-account-btn');
            
            if (accountItems.length <= 1) {
                // 只有一个账户时隐藏移除按钮
                removeButtons.forEach(btn => btn.style.display = 'none');
            } else {
                // 多个账户时显示所有移除按钮
                removeButtons.forEach(btn => btn.style.display = 'inline-flex');
            }
        }
        
        

        // 广告账户管理功能
        let adAccountIndex = 0;
        
        // 验证广告账户ID和名称绑定
        function validateAdAccountBinding(inputElement) {
            const accountItem = inputElement.closest('.ad-account-item');
            const idInput = accountItem.querySelector('input[name*="[id]"]');
            const nameInput = accountItem.querySelector('input[name*="[name]"]');
            
            // 检查ID和名称的唯一性绑定
            if (idInput.value && nameInput.value) {
                // 这里可以添加更多验证逻辑
                console.log(`广告账户绑定: ${idInput.value} <-> ${nameInput.value}`);
            }
        }
        
        // 创建新的广告账户项HTML
        function createAdAccountItem(index) {
            return `
                <div class="ad-account-item" data-account-index="${index}">
                    <div class="account-item-header">
                        <h5 class="account-item-title">广告账户 #${index + 1}</h5>
                        <button type="button" class="btn-enhanced btn-ghost btn-sm remove-account-btn" onclick="removeAdAccount(${index})">
                            <span class="btn__icon">🗑️</span>
                            移除
                        </button>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">广告账户ID</label>
                            <input type="text" 
                                   name="adAccounts[${index}][id]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入广告账户ID"
                                   required
                                   onchange="validateAdAccountBinding(this)">
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">广告账户名称</label>
                            <input type="text" 
                                   name="adAccounts[${index}][name]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入广告账户名称"
                                   required
                                   onchange="validateAdAccountBinding(this)">
                        </div>
                    </div>
                </div>
            `;
        }
        
        // 添加新的广告账户
        function addAdAccount() {
            adAccountIndex++;
            const adAccountsList = document.getElementById('adAccountsList');
            const newAccountItem = document.createElement('div');
            newAccountItem.innerHTML = createAdAccountItem(adAccountIndex);
            adAccountsList.appendChild(newAccountItem.firstElementChild);
            
            // 显示所有移除按钮
            updateAdAccountRemoveButtons();
            
            // 添加平滑显示动画
            const addedItem = adAccountsList.lastElementChild;
            addedItem.style.opacity = '0';
            addedItem.style.transform = 'translateY(-20px)';
            setTimeout(() => {
                addedItem.style.transition = 'all 0.3s ease-out';
                addedItem.style.opacity = '1';
                addedItem.style.transform = 'translateY(0)';
            }, 10);
        }
        
        // 移除广告账户
        function removeAdAccount(index) {
            const accountItem = document.querySelector(`.ad-account-item[data-account-index="${index}"]`);
            if (accountItem) {
                // 添加移除动画
                accountItem.style.transition = 'all 0.3s ease-out';
                accountItem.style.opacity = '0';
                accountItem.style.transform = 'translateX(-100%)';
                
                setTimeout(() => {
                    accountItem.remove();
                    updateAdAccountRemoveButtons();
                    updateAdAccountNumbers();
                }, 300);
            }
        }
        
        // 更新广告账户移除按钮显示状态
        function updateAdAccountRemoveButtons() {
            const adAccountItems = document.querySelectorAll('.ad-account-item');
            adAccountItems.forEach((item, index) => {
                const removeBtn = item.querySelector('.remove-account-btn');
                if (removeBtn) {
                    // 如果只有一个广告账户，隐藏移除按钮
                    removeBtn.style.display = adAccountItems.length > 1 ? 'inline-flex' : 'none';
                }
            });
        }
        
        // 更新广告账户编号
        function updateAdAccountNumbers() {
            const adAccountItems = document.querySelectorAll('.ad-account-item');
            adAccountItems.forEach((item, index) => {
                const title = item.querySelector('.account-item-title');
                if (title) {
                    title.textContent = `广告账户 #${index + 1}`;
                }
                
                // 更新 data-account-index
                item.setAttribute('data-account-index', index);
                
                // 更新表单字段名称
                const inputs = item.querySelectorAll('input');
                inputs.forEach(input => {
                    if (input.name) {
                        input.name = input.name.replace(/\[\d+\]/, `[${index}]`);
                    }
                });
                
                // 更新移除按钮的onclick
                const removeBtn = item.querySelector('.remove-account-btn');
                if (removeBtn) {
                    removeBtn.setAttribute('onclick', `removeAdAccount(${index})`);
                }
            });
        }
        
        // 商户ID和域名生成功能
        function generateMerchantId() {
            const merchantNameInput = document.getElementById('merchantName');
            const merchantIdInput = document.getElementById('merchantId');
            const domainPreview = document.getElementById('domainPreview');
            const domainSuffix = document.getElementById('domainSuffix');
            
            if (!merchantNameInput.value.trim()) {
                alert('请先输入商户名称');
                merchantNameInput.focus();
                return;
            }
            
            // 生成商户ID（基于名称和时间戳）
            const timestamp = Date.now().toString().substr(-6);
            const nameCode = merchantNameInput.value.trim().substring(0, 3).toUpperCase();
            const merchantId = `${nameCode}_${timestamp}`;
            
            merchantIdInput.value = merchantId;
            
            // 同时更新域名预览
            generateAndUpdateDomain(merchantId);
        }
        
        // 生成并更新充值域名
        function generateAndUpdateDomain(merchantId) {
            const domainPreview = document.getElementById('domainPreview');
            const domainSuffix = document.getElementById('domainSuffix');
            const domainBase = domainPreview.querySelector('.domain-base');
            
            if (merchantId && domainBase && domainSuffix) {
                const baseDomain = 'pay.cjpayment.com';
                const suffix = generateDomainSuffix();
                
                domainBase.textContent = `${baseDomain}/`;
                domainSuffix.textContent = suffix;
                
                // 存储生成的域名信息
                const merchantForm = document.getElementById('merchantForm');
                if (merchantForm) {
                    // 创建隐藏字段存储域名信息
                    let domainField = merchantForm.querySelector('input[name="rechargeDomain"]');
                    if (!domainField) {
                        domainField = document.createElement('input');
                        domainField.type = 'hidden';
                        domainField.name = 'rechargeDomain';
                        merchantForm.appendChild(domainField);
                    }
                    domainField.value = `${baseDomain}/${suffix}`;
                }
            }
        }
        
        // 验证必填项：商户名称、代理商ID、代理商名称、广告账户ID、广告账户名称
        function validateRequiredFields() {
            let isValid = true;
            
            // 清除之前的错误信息
            clearAllErrors();
            
            // 验证商户名称
            const merchantName = document.getElementById('merchantName').value.trim();
            if (!merchantName) {
                showError('merchantNameError', '请输入商户名称');
                isValid = false;
            }
            
            // 验证代理商ID
            const agentId = document.getElementById('agentId').value.trim();
            if (!agentId) {
                showError('agentIdError', '请输入代理商ID');
                isValid = false;
            }
            
            // 验证代理商名称
            const agentName = document.getElementById('agentName').value.trim();
            if (!agentName) {
                showError('agentNameError', '请输入代理商名称');
                isValid = false;
            }
            
            // 验证广告账户信息（至少一个）
            const firstAdAccountId = document.querySelector('input[name="adAccounts[0][id]"]');
            const firstAdAccountName = document.querySelector('input[name="adAccounts[0][name]"]');
            
            if (!firstAdAccountId || !firstAdAccountId.value.trim()) {
                // 需要显示在适当的位置
                alert('请输入广告账户ID');
                isValid = false;
            }
            
            if (!firstAdAccountName || !firstAdAccountName.value.trim()) {
                alert('请输入广告账户名称');
                isValid = false;
            }
            
            return isValid;
        }
        
        // 清除所有错误信息
        function clearAllErrors() {
            const errorElements = document.querySelectorAll('.form-error');
            errorElements.forEach(element => {
                element.textContent = '';
                element.style.display = 'none';
            });
        }
        
        // 显示错误信息
        function showError(elementId, message) {
            const errorElement = document.getElementById(elementId);
            if (errorElement) {
                errorElement.textContent = message;
                errorElement.style.display = 'block';
            }
        }
        
        // 银行名称切换功能（更新版本）
        function togglePaymentBankName(selectElement, index) {
            const bankNameRow = document.getElementById(`bankNameRow_${index}`);
            
            if (selectElement.value === 'bank') {
                // 显示银行名称字段
                bankNameRow.style.display = 'flex';
                
                // 添加平滑显示动画
                bankNameRow.style.opacity = '0';
                bankNameRow.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    bankNameRow.style.transition = 'all 0.3s ease-out';
                    bankNameRow.style.opacity = '1';
                    bankNameRow.style.transform = 'translateY(0)';
                }, 10);
            } else {
                // 隐藏银行名称字段
                bankNameRow.style.display = 'none';
                
                // 清空相关字段的值
                const bankNameSelect = bankNameRow.querySelector('select');
                const branchInfoInput = bankNameRow.querySelector('input');
                if (bankNameSelect) bankNameSelect.value = '';
                if (branchInfoInput) branchInfoInput.value = '';
            }
        }
        
        // 改进的付款账户管理
        
        // 更新付款账户移除按钮显示状态
        function updatePaymentAccountRemoveButtons() {
            const paymentAccountItems = document.querySelectorAll('.payment-account-item');
            paymentAccountItems.forEach((item, index) => {
                const removeBtn = item.querySelector('.remove-account-btn');
                if (removeBtn) {
                    // 如果只有一个付款账户，隐藏移除按钮
                    removeBtn.style.display = paymentAccountItems.length > 1 ? 'inline-flex' : 'none';
                }
            });
        }
        
        // 更新付款账户编号
        function updatePaymentAccountNumbers() {
            const paymentAccountItems = document.querySelectorAll('.payment-account-item');
            paymentAccountItems.forEach((item, index) => {
                const title = item.querySelector('.account-item-title');
                if (title) {
                    title.textContent = ;
                }
                
                // 更新 data-account-index
                item.setAttribute('data-account-index', index);
                
                // 更新表单字段名称
                const inputs = item.querySelectorAll('input, select');
                inputs.forEach(input => {
                    if (input.name) {
                        input.name = input.name.replace(/\[\d+\]/, );
                    }
                });
                
                // 更新移除按钮的onclick
                const removeBtn = item.querySelector('.remove-account-btn');
                if (removeBtn) {
                    removeBtn.setAttribute('onclick', );
                }
                
                // 更新银行选择的onchange
                const institutionSelect = item.querySelector('select[name*="[institution]"]');
                if (institutionSelect) {
                    institutionSelect.setAttribute('onchange', );
                }
                
                // 更新银行名称行的ID
                const bankNameRow = item.querySelector('.bank-name-row');
                if (bankNameRow) {
                    bankNameRow.id = ;
                }
            });
        }
        
        // 改进的移除付款账户函数
        function removePaymentAccount(index) {
            const accountItem = document.querySelector();
            if (accountItem) {
                // 添加移除动画
                accountItem.style.transition = 'all 0.3s ease-out';
                accountItem.style.opacity = '0';
                accountItem.style.transform = 'translateX(-100%)';
                
                setTimeout(() => {
                    accountItem.remove();
                    updatePaymentAccountRemoveButtons();
                    updatePaymentAccountNumbers();
                }, 300);
            }
        }
        
function createPaymentAccountItemNew(index) {
            return `
                <div class="payment-account-item" data-account-index="${index}">
                    <div class="account-item-header">
                        <h5 class="account-item-title">付款账户 #${index + 1}</h5>
                        <button type="button" class="btn-enhanced btn-ghost btn-sm remove-account-btn" onclick="removePaymentAccount(${index})" style="display: none;">
                            <span class="btn__icon">🗑️</span>
                            移除
                        </button>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">付款账户名称</label>
                            <input type="text" 
                                   name="paymentAccounts[${index}][name]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入付款账户名称"
                                   required>
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">付款账号</label>
                            <input type="text" 
                                   name="paymentAccounts[${index}][account]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入付款账号"
                                   required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">账户机构</label>
                            <select name="paymentAccounts[${index}][institution]" 
                                    class="form-input-enhanced"
                                    required
                                    onchange="togglePaymentBankName(this, ${index})">
                                <option value="">请选择账户机构</option>
                                <option value="bank">银行</option>
                                <option value="alipay">支付宝</option>
                                <option value="wechat">微信</option>
                                <option value="other">其它</option>
                            </select>
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">账户类型</label>
                            <select name="paymentAccounts[${index}][type]" 
                                    class="form-input-enhanced"
                                    required>
                                <option value="">请选择账户类型</option>
                                <option value="corporate">对公</option>
                                <option value="personal">对私</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- 银行选择字段（当选择银行时显示） -->
                    <div class="form-row bank-name-row" id="bankNameRow_${index}" style="display: none;">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">银行名称</label>
                            <select name="paymentAccounts[${index}][bankName]" class="form-input-enhanced">
                                <option value="">请选择银行</option>
                                <option value="icbc">中国工商银行</option>
                                <option value="ccb">中国建设银行</option>
                                <option value="abc">中国农业银行</option>
                                <option value="boc">中国银行</option>
                                <option value="bcom">交通银行</option>
                                <option value="cmb">招商银行</option>
                                <option value="spdb">浦发银行</option>
                                <option value="citic">中信银行</option>
                                <option value="ceb">光大银行</option>
                                <option value="cmbc">民生银行</option>
                                <option value="hxb">华夏银行</option>
                                <option value="pingan">平安银行</option>
                                <option value="cib">兴业银行</option>
                                <option value="other_bank">其它银行</option>
                            </select>
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">开户行信息</label>
                            <input type="text" 
                                   name="paymentAccounts[${index}][branchInfo]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入开户行信息（选填）"
                                   maxlength="100">
                        </div>
                    </div>
                </div>
            `;
        }

// 更新账户编号
        function updateAccountNumbers() {
            const accountItems = document.querySelectorAll('.payment-account-item');
            accountItems.forEach((item, index) => {
                const title = item.querySelector('.account-item-title');
                title.textContent = `付款账户 #${index + 1}`;
                item.setAttribute('data-account-index', index);
                
                // 更新所有输入字段的name属性
                const inputs = item.querySelectorAll('input, select');
                inputs.forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.includes('paymentAccounts[')) {
                        const newName = name.replace(/paymentAccounts\[\d+\]/, `paymentAccounts[${index}]`);
                        input.setAttribute('name', newName);
                    }
                });
                
                // 更新ID属性
                const bankNameRow = item.querySelector('.bank-name-row');
                const manualBankGroup = item.querySelector('.manual-bank-group');
                if (bankNameRow) {
                    bankNameRow.id = `bankNameRow_${index}`;
                }
                if (manualBankGroup) {
                    manualBankGroup.id = `manualBankGroup_${index}`;
                }
                
                // 更新onclick属性
                const removeBtn = item.querySelector('.remove-account-btn');
                const typeSelect = item.querySelector('.payment-account-type-select');
                const bankSelect = item.querySelector('.bank-name-select');
                
                if (removeBtn) {
                    removeBtn.setAttribute('onclick', `removePaymentAccount(${index})`);
                }
                if (typeSelect) {
                    typeSelect.setAttribute('onchange', `togglePaymentBankName(this, ${index})`);
                }
                if (bankSelect) {
                    bankSelect.setAttribute('onchange', `handlePaymentBankNameChange(this, ${index})`);
                }
            });
        }
        
        // 页面加载完成后绑定事件
        document.addEventListener('DOMContentLoaded', function() {
            // 绑定添加付款账户按钮事件
            const addPaymentAccountBtn = document.getElementById('addPaymentAccountBtn');
            if (addPaymentAccountBtn) {
                addPaymentAccountBtn.addEventListener('click', addPaymentAccount);
            }
            
            // 为第一个账户绑定银行名称选择事件
            const firstBankSelect = document.querySelector('select[name="paymentAccounts[0][bankName]"]');
            if (firstBankSelect) {
                firstBankSelect.addEventListener('change', function() {
                    handlePaymentBankNameChange(this, 0);
                });
            }
            
            // 绑定轮询配置按钮事件
            const pollingConfigBtn = document.getElementById('pollingConfigBtn');
            if (pollingConfigBtn) {
                pollingConfigBtn.addEventListener('click', function() {
                    const pollingModal = document.getElementById('pollingConfigModal');
                    if (pollingModal) {
                        pollingModal.style.display = 'flex';
                        pollingModal.setAttribute('aria-hidden', 'false');
                    }
                });
            }
            
            // 绑定轮询配置模态框事件
            const pollingModalClose = document.getElementById('pollingConfigModalClose');
            const cancelPollingConfigBtn = document.getElementById('cancelPollingConfigBtn');
            const addReceivingAccountBtnModal = document.getElementById('addReceivingAccountBtn');
            const previewPollingConfigBtn = document.getElementById('previewPollingConfigBtn');
            
            // 关闭轮询配置模态框
            function closePollingConfigModal() {
                const pollingModal = document.getElementById('pollingConfigModal');
                if (pollingModal) {
                    pollingModal.style.display = 'none';
                    pollingModal.setAttribute('aria-hidden', 'true');
                }
            }
            
            if (pollingModalClose) {
                pollingModalClose.addEventListener('click', closePollingConfigModal);
            }
            
            if (cancelPollingConfigBtn) {
                cancelPollingConfigBtn.addEventListener('click', closePollingConfigModal);
            }
            
            // 添加收款账号按钮
            if (addReceivingAccountBtnModal) {
                addReceivingAccountBtnModal.addEventListener('click', addReceivingAccount);
            }
            
            // 预览配置按钮
            if (previewPollingConfigBtn) {
                previewPollingConfigBtn.addEventListener('click', previewPollingConfig);
            }
            
            // 轮询配置表单提交
            const pollingConfigForm = document.getElementById('pollingConfigForm');
            if (pollingConfigForm) {
                pollingConfigForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    // 这里可以添加表单验证和提交逻辑
                    console.log('轮询配置表单提交');
                    
                    // 模拟保存成功
                    setTimeout(() => {
                        alert('轮询配置保存成功！');
                        closePollingConfigModal();
                    }, 1000);
                });
            }
        });
        
        // 轮询配置管理
        let receivingAccountIndex = 0;
        
        // 创建新的收款账号项HTML
        function createReceivingAccountItem(index) {
            return `
                <div class="receiving-account-item" data-receiving-index="${index}">
                    <div class="account-item-header">
                        <h5 class="account-item-title">收款号 #${index + 1}</h5>
                        <button type="button" class="btn btn-ghost btn-sm remove-receiving-btn" onclick="removeReceivingAccount(${index})">
                            <span class="btn__icon">🗑️</span>
                            移除
                        </button>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">收款账号</label>
                            <input type="text" 
                                   name="receivingAccounts[${index}][account]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入收款账号"
                                   required>
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">收款账户名称</label>
                            <input type="text" 
                                   name="receivingAccounts[${index}][name]" 
                                   class="form-input-enhanced" 
                                   placeholder="请输入收款账户名称（可选）">
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced required">账户类型</label>
                            <select name="receivingAccounts[${index}][type]" class="form-select-enhanced" required>
                                <option value="">请选择账户类型</option>
                                <option value="bank">银行账户</option>
                                <option value="alipay">支付宝</option>
                                <option value="wechat">微信支付</option>
                                <option value="other">其他</option>
                            </select>
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">权重</label>
                            <input type="number" 
                                   name="receivingAccounts[${index}][weight]" 
                                   class="form-input-enhanced" 
                                   placeholder="1"
                                   value="1"
                                   min="1"
                                   max="100"
                                   title="权重越高，被选中的概率越大">
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">日限额</label>
                            <input type="number" 
                                   name="receivingAccounts[${index}][dailyLimit]" 
                                   class="form-input-enhanced" 
                                   placeholder="0"
                                   min="0"
                                   step="0.01"
                                   title="0表示无限制">
                        </div>
                        
                        <div class="form-group-enhanced">
                            <label class="form-label-enhanced">单笔限额</label>
                            <input type="number" 
                                   name="receivingAccounts[${index}][singleLimit]" 
                                   class="form-input-enhanced" 
                                   placeholder="0"
                                   min="0"
                                   step="0.01"
                                   title="0表示无限制">
                        </div>
                    </div>
                </div>
            `;
        }
        
        // 添加新的收款账号
        function addReceivingAccount() {
            receivingAccountIndex++;
            const receivingAccountsList = document.getElementById('receivingAccountsList');
            const newAccountItem = document.createElement('div');
            newAccountItem.innerHTML = createReceivingAccountItem(receivingAccountIndex);
            receivingAccountsList.appendChild(newAccountItem.firstElementChild);
            
            // 显示所有移除按钮
            updateReceivingRemoveButtons();
            
            // 添加平滑显示动画
            const addedItem = receivingAccountsList.lastElementChild;
            addedItem.style.opacity = '0';
            addedItem.style.transform = 'translateY(-20px)';
            setTimeout(() => {
                addedItem.style.transition = 'all 0.3s ease-out';
                addedItem.style.opacity = '1';
                addedItem.style.transform = 'translateY(0)';
            }, 10);
        }
        
        // 移除收款账号
        function removeReceivingAccount(index) {
            const accountItem = document.querySelector(`[data-receiving-index="${index}"]`);
            if (accountItem) {
                // 添加移除动画
                accountItem.style.transition = 'all 0.3s ease-out';
                accountItem.style.opacity = '0';
                accountItem.style.transform = 'translateX(-100%)';
                
                setTimeout(() => {
                    accountItem.remove();
                    updateReceivingRemoveButtons();
                    updateReceivingAccountNumbers();
                }, 300);
            }
        }
        
        // 更新移除按钮显示状态
        function updateReceivingRemoveButtons() {
            const accountItems = document.querySelectorAll('.receiving-account-item');
            const removeButtons = document.querySelectorAll('.remove-receiving-btn');
            
            if (accountItems.length <= 1) {
                // 只有一个账户时隐藏移除按钮
                removeButtons.forEach(btn => btn.style.display = 'none');
            } else {
                // 多个账户时显示所有移除按钮
                removeButtons.forEach(btn => btn.style.display = 'inline-flex');
            }
        }
        
        // 更新收款账号编号
        function updateReceivingAccountNumbers() {
            const accountItems = document.querySelectorAll('.receiving-account-item');
            accountItems.forEach((item, index) => {
                const title = item.querySelector('.account-item-title');
                title.textContent = `收款号 #${index + 1}`;
                item.setAttribute('data-receiving-index', index);
                
                // 更新所有输入字段的name属性
                const inputs = item.querySelectorAll('input, select');
                inputs.forEach(input => {
                    const name = input.getAttribute('name');
                    if (name && name.includes('receivingAccounts[')) {
                        const newName = name.replace(/receivingAccounts\[\d+\]/, `receivingAccounts[${index}]`);
                        input.setAttribute('name', newName);
                    }
                });
                
                // 更新onclick属性
                const removeBtn = item.querySelector('.remove-receiving-btn');
                if (removeBtn) {
                    removeBtn.setAttribute('onclick', `removeReceivingAccount(${index})`);
                }
            });
        }
        
        // 轮询配置预览
        function previewPollingConfig() {
            const form = document.getElementById('pollingConfigForm');
            const formData = new FormData(form);
            
            // 收集表单数据
            const config = {
                ruleName: formData.get('ruleName'),
                description: formData.get('description'),
                pollingMode: formData.get('pollingMode'),
                interval: formData.get('interval'),
                maxRetry: formData.get('maxRetry'),
                effectiveTime: formData.get('effectiveTime'),
                expiryTime: formData.get('expiryTime'),
                remark: formData.get('remark'),
                receivingAccounts: [],
                options: {
                    enableFailover: formData.get('enableFailover') === 'on',
                    enableLimitCheck: formData.get('enableLimitCheck') === 'on',
                    enableLogging: formData.get('enableLogging') === 'on',
                    enableNotification: formData.get('enableNotification') === 'on'
                }
            };
            
            // 收集收款账号数据
            const receivingItems = document.querySelectorAll('.receiving-account-item');
            receivingItems.forEach((item, index) => {
                const account = formData.get(`receivingAccounts[${index}][account]`);
                if (account) {
                    config.receivingAccounts.push({
                        account: account,
                        name: formData.get(`receivingAccounts[${index}][name]`) || '',
                        type: formData.get(`receivingAccounts[${index}][type]`) || '',
                        weight: parseInt(formData.get(`receivingAccounts[${index}][weight]`)) || 1,
                        dailyLimit: parseFloat(formData.get(`receivingAccounts[${index}][dailyLimit]`)) || 0,
                        singleLimit: parseFloat(formData.get(`receivingAccounts[${index}][singleLimit]`)) || 0
                    });
                }
            });
            
            // 显示预览弹窗
            showPollingConfigPreview(config);
        }
        
        // 显示轮询配置预览
        function showPollingConfigPreview(config) {
            const previewContent = `
                <div class="config-preview">
                    <h3>轮询配置预览</h3>
                    <div class="preview-section">
                        <h4>基础信息</h4>
                        <p><strong>规则名称:</strong> ${config.ruleName || '未设置'}</p>
                        <p><strong>规则描述:</strong> ${config.description || '无'}</p>
                        <p><strong>轮询模式:</strong> ${getPollingModeText(config.pollingMode)}</p>
                        <p><strong>轮询间隔:</strong> ${config.interval || 30}秒</p>
                        <p><strong>最大重试:</strong> ${config.maxRetry || 3}次</p>
                    </div>
                    <div class="preview-section">
                        <h4>收款账号 (${config.receivingAccounts.length}个)</h4>
                        ${config.receivingAccounts.map((acc, index) => `
                            <div class="account-preview">
                                <p><strong>账号${index + 1}:</strong> ${acc.account} (${getAccountTypeText(acc.type)})</p>
                                <p><strong>权重:</strong> ${acc.weight} | <strong>日限额:</strong> ${acc.dailyLimit || '无限制'} | <strong>单笔限额:</strong> ${acc.singleLimit || '无限制'}</p>
                            </div>
                        `).join('')}
                    </div>
                    <div class="preview-section">
                        <h4>高级选项</h4>
                        <p><strong>故障转移:</strong> ${config.options.enableFailover ? '启用' : '禁用'}</p>
                        <p><strong>限额检查:</strong> ${config.options.enableLimitCheck ? '启用' : '禁用'}</p>
                        <p><strong>详细日志:</strong> ${config.options.enableLogging ? '启用' : '禁用'}</p>
                        <p><strong>异常通知:</strong> ${config.options.enableNotification ? '启用' : '禁用'}</p>
                    </div>
                </div>
            `;
            
            // 显示模态框
            if (typeof window.CJComponents !== 'undefined' && window.CJComponents.showModal) {
                window.CJComponents.showModal('配置预览', previewContent);
            } else {
                alert('预览功能需要组件库支持');
            }
        }
        
        function getPollingModeText(mode) {
            const modes = {
                'round_robin': '轮询模式',
                'random': '随机模式',
                'weighted': '权重模式',
                'load_balance': '负载均衡'
            };
            return modes[mode] || '未知模式';
        }
        
        function getAccountTypeText(type) {
            const types = {
                'bank': '银行账户',
                'alipay': '支付宝',
                'wechat': '微信支付',
                'other': '其他'
            };
            return types[type] || '未知类型';
        }
    </script>
    
    <!-- Initialize Merchant Management -->
    <script>
        // 生成随机域名后缀
        function generateDomainSuffix(length = 6) {
            const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
            let suffix = '';
            for (let i = 0; i < length; i++) {
                suffix += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return suffix;
        }
        
        // 更新域名预览
        function updateDomainPreview() {
            const domainPreview = document.getElementById('domainPreview');
            const domainSuffix = document.getElementById('domainSuffix');
            
            if (domainPreview && domainSuffix) {
                const baseDomain = 'pay.cjpayment.com';  // 从系统配置获取
                const suffix = generateDomainSuffix();
                
                domainPreview.querySelector('.domain-base').textContent = baseDomain + '/';
                domainSuffix.textContent = suffix;
            }
        }
        
