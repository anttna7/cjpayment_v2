        // 更新表格视图
        function updateTableView(merchants) {
            const tbody = document.getElementById('merchantTableBody');
            if (!tbody) return;
            
            tbody.innerHTML = '';
            
            merchants.forEach((merchant, index) => {
                const statusClass = merchant.status === 'active' ? 'status-active' : 
                                  merchant.status === 'pending' ? 'status-pending' : 'status-inactive';
                const statusText = merchant.status === 'active' ? '活跃' :
                                 merchant.status === 'pending' ? '待审核' : '非活跃';
                                 
                const row = `
                    <tr>
                        <td><input type="checkbox" id="merchant_${index}" aria-label="选择商户"></td>
                        <td>
                            <div class="merchant-info">
                                <div class="merchant-name">${merchant.name}</div>
                                <div class="merchant-id">ID: ${merchant.id}</div>
                                <div class="merchant-contact">联系人: ${merchant.contact} | ${merchant.phone}</div>
                            </div>
                        </td>
                        <td>${merchant.adAccountId}</td>
                        <td>${merchant.adAccountName}</td>
                        <td>${merchant.agencyName}</td>
                        <td>¥${merchant.todayRecharge.toFixed(2)}</td>
                        <td>¥${merchant.monthlyRecharge.toFixed(2)}</td>
                        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
                        <td>
                            <div class="action-buttons">
                                <button class="btn-sm btn-outline" onclick="editMerchant('${merchant.id}')" title="编辑">✏️</button>
                                <button class="btn-sm btn-outline" onclick="viewMerchant('${merchant.id}')" title="查看">👁️</button>
                                <button class="btn-sm btn-danger" onclick="deleteMerchant('${merchant.id}')" title="删除">🗑️</button>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.innerHTML += row;
            });
        }
        
        // 更新卡片视图
        function updateGridView(merchants) {
            const grid = document.getElementById('merchantGrid');
            if (!grid) return;
            
            grid.innerHTML = '';
            
            merchants.forEach(merchant => {
                const statusClass = merchant.status === 'active' ? 'status-active' : 
                                  merchant.status === 'pending' ? 'status-pending' : 'status-inactive';
                const statusText = merchant.status === 'active' ? '活跃' :
                                 merchant.status === 'pending' ? '待审核' : '非活跃';
                                 
                const card = `
                    <div class="merchant-card">
                        <div class="merchant-card__header">
                            <div class="merchant-card__info">
                                <div class="merchant-card__name">${merchant.name}</div>
                                <div class="merchant-card__id">ID: ${merchant.id}</div>
                            </div>
                            <span class="status-badge ${statusClass}">${statusText}</span>
                        </div>
                        <div class="merchant-card__details">
                            <div class="merchant-detail">
                                <div class="merchant-detail__label">联系人</div>
                                <div class="merchant-detail__value">${merchant.contact}</div>
                            </div>
                            <div class="merchant-detail">
                                <div class="merchant-detail__label">广告账户</div>
                                <div class="merchant-detail__value">${merchant.adAccountName}</div>
                            </div>
                            <div class="merchant-detail">
                                <div class="merchant-detail__label">今日充值</div>
                                <div class="merchant-detail__value">¥${merchant.todayRecharge.toFixed(2)}</div>
                            </div>
                            <div class="merchant-detail">
                                <div class="merchant-detail__label">创建时间</div>
                                <div class="merchant-detail__value">${merchant.createdAt}</div>
                            </div>
                        </div>
                        <div class="merchant-card__actions">
                            <button class="btn-sm btn-outline" onclick="editMerchant('${merchant.id}')" title="编辑">✏️ 编辑</button>
                            <button class="btn-sm btn-outline" onclick="viewMerchant('${merchant.id}')" title="查看">👁️ 查看</button>
                            <button class="btn-sm btn-danger" onclick="deleteMerchant('${merchant.id}')" title="删除">🗑️ 删除</button>
                        </div>
                    </div>
                `;
                grid.innerHTML += card;
            });
        }
        
        // 统一模态框管理函数
        // 通用模态框控制函数
        function openModal(modalId, overlayId) {
            const overlay = document.getElementById(overlayId);
            const modal = document.getElementById(modalId);
            if (overlay && modal) {
                overlay.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
                
                // 聚焦第一个可聚焦元素
                const firstFocusable = modal.querySelector('input:not([readonly]), button:not([disabled]), select:not([disabled]), textarea:not([readonly])');
                if (firstFocusable) {
                    setTimeout(() => firstFocusable.focus(), 100);
                }
            }
        }

        function closeModal(modalId, overlayId) {
            const overlay = document.getElementById(overlayId);
            const modal = document.getElementById(modalId);
            if (overlay && modal) {
                overlay.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
            }
        }

        // 删除确认模态框函数
        function openDeleteModal() {
            openModal('deleteModal', 'deleteModalOverlay');
        }

        function closeDeleteModal() {
            closeModal('deleteModal', 'deleteModalOverlay');
        }

        // 充值链接管理模态框函数
        function openRechargeLinkModal() {
            openModal('rechargeLinkModal', 'rechargeLinkModalOverlay');
        }

        function closeRechargeLinkModal() {
            closeModal('rechargeLinkModal', 'rechargeLinkModalOverlay');
        }

        // 轮询配置模态框函数
        function openPollingConfigModal() {
            openModal('pollingConfigModal', 'pollingConfigModalOverlay');
        }

        function closePollingConfigModal() {
            closeModal('pollingConfigModal', 'pollingConfigModalOverlay');
        }

        // 批量导入模态框函数
        function openImportModal() {
            openModal('importModal', 'importModalOverlay');
        }

        function closeImportModal() {
            closeModal('importModal', 'importModalOverlay');
        }

        // 绑定模态框事件监听器
        function bindModalEvents() {
            // 删除确认模态框
            const deleteModalClose = document.getElementById('deleteModalClose');
            const deleteCancelBtn = document.getElementById('deleteCancelBtn');
            const deleteModalOverlay = document.getElementById('deleteModalOverlay');
            
            if (deleteModalClose) deleteModalClose.addEventListener('click', closeDeleteModal);
            if (deleteCancelBtn) deleteCancelBtn.addEventListener('click', closeDeleteModal);
            if (deleteModalOverlay) {
                deleteModalOverlay.addEventListener('click', function(e) {
                    if (e.target === deleteModalOverlay) closeDeleteModal();
                });
            }

            // 充值链接管理模态框
            const rechargeLinkModalClose = document.getElementById('rechargeLinkModalClose');
            const closeLinkModalBtn = document.getElementById('closeLinkModalBtn');
            const rechargeLinkModalOverlay = document.getElementById('rechargeLinkModalOverlay');
            
            if (rechargeLinkModalClose) rechargeLinkModalClose.addEventListener('click', closeRechargeLinkModal);
            if (closeLinkModalBtn) closeLinkModalBtn.addEventListener('click', closeRechargeLinkModal);
            if (rechargeLinkModalOverlay) {
                rechargeLinkModalOverlay.addEventListener('click', function(e) {
                    if (e.target === rechargeLinkModalOverlay) closeRechargeLinkModal();
                });
            }

            // 轮询配置模态框
            const pollingConfigModalClose = document.getElementById('pollingConfigModalClose');
            const cancelPollingConfigBtn = document.getElementById('cancelPollingConfigBtn');
            const pollingConfigModalOverlay = document.getElementById('pollingConfigModalOverlay');
            
            if (pollingConfigModalClose) pollingConfigModalClose.addEventListener('click', closePollingConfigModal);
            if (cancelPollingConfigBtn) cancelPollingConfigBtn.addEventListener('click', closePollingConfigModal);
            if (pollingConfigModalOverlay) {
                pollingConfigModalOverlay.addEventListener('click', function(e) {
                    if (e.target === pollingConfigModalOverlay) closePollingConfigModal();
                });
            }

            // 批量导入模态框
            const importModalClose = document.getElementById('importModalClose');
            const cancelImportBtn = document.getElementById('cancelImportBtn');
            const importModalOverlay = document.getElementById('importModalOverlay');
            
            if (importModalClose) importModalClose.addEventListener('click', closeImportModal);
            if (cancelImportBtn) cancelImportBtn.addEventListener('click', closeImportModal);
            if (importModalOverlay) {
                importModalOverlay.addEventListener('click', function(e) {
                    if (e.target === importModalOverlay) closeImportModal();
                });
            }

            // 通用ESC键关闭功能
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    const activeOverlays = document.querySelectorAll('.modal-overlay.active');
                    activeOverlays.forEach(overlay => {
                        overlay.classList.remove('active');
                        const modal = overlay.querySelector('.modal-enhanced');
                        if (modal) modal.setAttribute('aria-hidden', 'true');
                    });
                }
            });
        }

        // 商户模态框控制函数
        function openMerchantModal() {
            const overlay = document.getElementById('merchantModalOverlay');
            const modal = document.getElementById('merchantModal');
            if (overlay && modal) {
                overlay.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
                // 重置表单
                const form = document.getElementById('merchantForm');
                if (form) {
                    form.reset();
                }
                // 更新域名预览
                updateDomainPreview();
                // 聚焦第一个输入框
                const firstInput = modal.querySelector('input[type="text"]:not([readonly])');
                if (firstInput) {
                    setTimeout(() => firstInput.focus(), 100);
                }
            }
        }
        
        function closeMerchantModal() {
            const overlay = document.getElementById('merchantModalOverlay');
            const modal = document.getElementById('merchantModal');
            if (overlay && modal) {
                overlay.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
            }
        }
        
        // 商户表单提交处理
        function handleMerchantSubmit(event) {
            event.preventDefault();
            
            // 验证必填项
            if (!validateRequiredFields()) {
                return;
            }
            
            const form = document.getElementById('merchantForm');
            const formData = new FormData(form);
            
            // 显示保存中状态
            const saveBtn = document.getElementById('saveBtn');
            const btnText = saveBtn.querySelector('.btn__text');
            const btnLoading = saveBtn.querySelector('.btn__loading');
            
            btnText.style.display = 'none';
            btnLoading.style.display = 'inline-flex';
            saveBtn.disabled = true;
            
            // 收集表单数据
            const merchantData = {
                name: formData.get('merchantName') || '',
                agentId: formData.get('agentId') || '',
                agentName: formData.get('agentName') || '',
                contact: formData.get('contactPerson') || '',
                phone: formData.get('contactPhone') || '',
                email: formData.get('contactEmail') || '',
                address: formData.get('address') || '',
                description: formData.get('description') || '',
                status: formData.get('merchantStatus') || 'pending',
                transactionLimit: formData.get('transactionLimit') || 0,
                paymentAccounts: []
            };
            
            // 收集付款账户数据
            const accountItems = document.querySelectorAll('.payment-account-item');
            accountItems.forEach((item, index) => {
                const name = item.querySelector(`input[name="paymentAccounts[${index}][name]"]`)?.value || '';
                const account = item.querySelector(`input[name="paymentAccounts[${index}][account]"]`)?.value || '';
                const type = item.querySelector(`select[name="paymentAccounts[${index}][businessType]"]`)?.value || '';
                const institution = item.querySelector(`select[name="paymentAccounts[${index}][type]"]`)?.value || '';
                const bankName = item.querySelector(`select[name="paymentAccounts[${index}][bankName]"]`)?.value || '';
                const manualBankName = item.querySelector(`input[name="paymentAccounts[${index}][manualBankName]"]`)?.value || '';
                
                if (account) {
                    merchantData.paymentAccounts.push({
                        name,
                        account,
                        type,
                        institution,
                        bankName: bankName === 'manual' ? manualBankName : bankName
                    });
                }
            });
            
            console.log('提交商户数据:', merchantData);
            
            // 模拟API调用
            fetch('/api/merchants', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(merchantData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const merchant = data.merchant;
                    const successMsg = `✅ 商户创建成功！
                    
📋 商户信息:
• 商户ID: ${merchant.id}
• 创建时间: ${new Date(merchant.created_at).toLocaleString()}

🌐 充值域名信息:
• 充值域名: ${merchant.recharge_domain}
• 充值链接: ${merchant.recharge_link}
• 域名后缀: ${merchant.domain_suffix}
• SSL加密: ${merchant.ssl_enabled ? '已启用' : '未启用'}

✨ 域名已自动生成并分配！`;
                    
                    alert(successMsg);
                    closeMerchantModal();
                    // 刷新页面或更新列表
                    if (typeof window.location !== 'undefined') {
                        window.location.reload();
                    }
                } else {
                    alert('商户创建失败: ' + (data.message || '未知错误'));
                }
            })
            .catch(error => {
                console.error('提交失败:', error);
                alert('商户创建失败: ' + error.message);
            })
            .finally(() => {
                // 恢复按钮状态
                btnText.style.display = 'inline';
                btnLoading.style.display = 'none';
                saveBtn.disabled = false;
            });
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            // 注释掉重复的添加商户按钮绑定，使用增强版管理系统的绑定
            const addMerchantBtn = document.getElementById('addMerchant');
            if (addMerchantBtn) {
                addMerchantBtn.addEventListener('click', openMerchantModal);
            }
            
            // 绑定模态框关闭按钮
            const modalClose = document.getElementById('modalClose');
            const cancelBtn = document.getElementById('cancelBtn');
            
            if (modalClose) {
                modalClose.addEventListener('click', closeMerchantModal);
            }
            
            if (cancelBtn) {
                cancelBtn.addEventListener('click', closeMerchantModal);
            }
            
            // 绑定表单提交
            const merchantForm = document.getElementById('merchantForm');
            if (merchantForm) {
                merchantForm.addEventListener('submit', handleMerchantSubmit);
            }
            
            // 点击模态框背景关闭
            const overlay = document.getElementById('merchantModalOverlay');
            if (overlay) {
                overlay.addEventListener('click', function(e) {
                    if (e.target === overlay) {
                        closeMerchantModal();
                    }
                });
            }
            
            // ESC键关闭模态框
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    const overlay = document.getElementById('merchantModalOverlay');
                    if (overlay && overlay.classList.contains('active')) {
                        closeMerchantModal();
                    }
                }
            });
            
            // 添加字符计数功能
            const description = document.getElementById('description');
            if (description) {
                const counter = description.parentElement.querySelector('.field-counter .counter-current');
                if (counter) {
                    description.addEventListener('input', function() {
                        const length = this.value.length;
                        counter.textContent = length;
                        
                        // 更新计数器状态
                        const counterParent = counter.parentElement;
                        counterParent.classList.remove('warning', 'error');
                        
                        if (length > 400) {
                            counterParent.classList.add('error');
                        } else if (length > 300) {
                            counterParent.classList.add('warning');
                        }
                    });
                }
            }
            
            // 绑定统一模态框事件
            bindModalEvents();
            
            console.log('商户管理基础功能已初始化');
            // 绑定新的商户模态框功能
            const generateMerchantIdBtn = document.getElementById('generateMerchantIdBtn');
            const addAdAccountBtn = document.getElementById('addAdAccountBtn');
            const addPaymentAccountBtn = document.getElementById('addPaymentAccountBtn');
            
            if (generateMerchantIdBtn) {
                generateMerchantIdBtn.addEventListener('click', function() {
                    const merchantNameInput = document.getElementById('merchantName');
                    const merchantIdInput = document.getElementById('merchantId');
                    
                    if (!merchantNameInput.value.trim()) {
                        alert('请先输入商户名称');
                        return;
                    }
                    
                    // 生成商户ID（基于时间戳）
                    const timestamp = Date.now().toString(36);
                    const random = Math.random().toString(36).substr(2, 4);
                    const merchantId = 'M' + timestamp + random;
                    
                    merchantIdInput.value = merchantId.toUpperCase();
                });
            }
            
            
            if (addAdAccountBtn) {
                addAdAccountBtn.addEventListener('click', addAdAccount);
            }
            
            if (addPaymentAccountBtn) {
                addPaymentAccountBtn.addEventListener('click', function() {
                    paymentAccountIndex++;
                    const paymentAccountsList = document.getElementById('paymentAccountsList');
                    const newAccountItem = document.createElement('div');
                    newAccountItem.innerHTML = createPaymentAccountItemNew(paymentAccountIndex);
                    paymentAccountsList.appendChild(newAccountItem.firstElementChild);
                    
                    // 显示所有移除按钮
                    updatePaymentAccountRemoveButtons();
                    
                    // 添加平滑显示动画
                    const addedItem = paymentAccountsList.lastElementChild;
                    addedItem.style.opacity = '0';
                    addedItem.style.transform = 'translateY(-20px)';
                    setTimeout(() => {
                        addedItem.style.transition = 'all 0.3s ease-out';
                        addedItem.style.opacity = '1';
                        addedItem.style.transform = 'translateY(0)';
                    }, 10);
                });
            }
            
            // 初始化广告账户和付款账户的移除按钮状态
            updateAdAccountRemoveButtons();
            updatePaymentAccountRemoveButtons();
            
            console.log('新商户模态框功能已初始化');
            
            // 加载基础演示数据
            loadBasicMerchantData();
            
            // 商户管理系统已在页面顶部初始化，此处不重复初始化
            console.log('商户管理系统基础功能已就绪');
            
            // 初始化统一头部组件
            try {
                if (typeof HeaderUnified !== 'undefined') {
                    window.headerUnified = new HeaderUnified();
                }
            } catch (error) {
                console.log('头部组件初始化失败:', error.message);
            }
        });
        
        // 切换银行名称字段显示
        function toggleBankName(context) {
            let accountTypeSelect, bankNameGroup;
            
            if (context === 'merchant') {
                accountTypeSelect = document.getElementById('paymentAccountType');
                bankNameGroup = document.getElementById('merchantBankNameGroup');
            } else if (context === 'account') {
                accountTypeSelect = document.getElementById('accountType');
                bankNameGroup = document.getElementById('accountBankNameGroup');
            }
            
            if (accountTypeSelect && bankNameGroup) {
                const selectedType = accountTypeSelect.value;
                const bankNameInput = bankNameGroup.querySelector('select');
                
                if (selectedType === '银行卡') {
                    bankNameGroup.style.display = 'block';
                    if (bankNameInput) {
                        bankNameInput.setAttribute('required', 'required');
                    }
                } else {
                    bankNameGroup.style.display = 'none';
                    if (bankNameInput) {
                        bankNameInput.removeAttribute('required');
                        bankNameInput.value = '';
                    }
                }
            }
        }
    </script>

    <!-- Additional Styles -->
    <style>
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        
        /* 表单分组样式 */
        .form-section {
            margin: 2rem 0;
            padding: 1.5rem;
            background: var(--dashboard-bg-secondary);
            border: 1px solid var(--dashboard-border-light);
            border-radius: 12px;
            position: relative;
        }
        
        .form-section-title {
            margin: 0 0 1.5rem 0;
            color: var(--dashboard-primary);
            font-size: 1.1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .form-section-title::before {
            content: "📋";
            font-size: 1rem;
        }
        
        /* 广告和代理商信息图标 */
        .form-section:has(.form-section-title:first-child:contains("广告")) .form-section-title::before {
            content: "📱";
        }
        
        /* 付款账户信息图标 */
        .form-section:has(.form-section-title:first-child:contains("付款")) .form-section-title::before {
            content: "💳";
        }
        
        .form-section:has(.form-section-title:first-child:contains("绑定")) .form-section-title::before {
            content: "🔗";
        }
        
        /* 复选框组样式 */
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 0.5rem;
        }
        
        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            transition: background-color 0.2s ease;
        }
        
        .checkbox-item:hover {
            background: var(--dashboard-bg-tertiary);
        }
        
        .checkbox-item input[type="checkbox"] {
            width: 16px;
            height: 16px;
            border: 2px solid var(--dashboard-border-medium);
            border-radius: 3px;
            background: var(--dashboard-bg-secondary);
            cursor: pointer;
            position: relative;
            appearance: none;
            transition: all 0.2s ease;
        }
        
        .checkbox-item input[type="checkbox"]:checked {
            background: var(--dashboard-primary);
            border-color: var(--dashboard-primary);
        }
        
        .checkbox-item input[type="checkbox"]:checked::after {
            content: '✓';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 10px;
            font-weight: bold;
        }
        
        .checkbox-label {
            font-size: 0.875rem;
            color: var(--dashboard-text-primary);
            font-weight: 500;
        }
        
        /* 新增字段样式 */
        .payment-type-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 500;
            background: var(--dashboard-primary-light);
            color: var(--dashboard-primary);
            margin-right: 0.5rem;
        }
        
        .business-type-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 500;
        }
        
        .business-type-badge.corporate {
            background: var(--status-success-light);
            color: var(--status-success);
        }
        
        .business-type-badge.personal {
            background: var(--status-info-light);
            color: var(--status-info);
        }
        
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
            
            .form-section {
                margin: 1rem 0;
                padding: 1rem;
            }
            
            .payment-type-badge,
            .business-type-badge {
                margin-bottom: 0.25rem;
            }
        }
        
        /* 表格信息样式 */
        .company-info .company-name {
            font-weight: 600;
            color: var(--dashboard-text-primary);
            margin-bottom: 0.25rem;
        }
        
        .company-info .ad-account-id {
            font-size: 0.75rem;
            color: var(--dashboard-text-muted);
        }
        
        .payment-info {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }
        
        .payment-account {
            font-size: 0.75rem;
            color: var(--dashboard-text-muted);
            font-family: monospace;
        }
        
        .agency-info .agency-name {
            font-weight: 500;
            color: var(--dashboard-text-primary);
            margin-bottom: 0.25rem;
        }
        
        .agency-info .agency-id {
            font-size: 0.75rem;
            color: var(--dashboard-text-muted);
            font-family: monospace;
        }
        
        .warning-text {
            color: var(--status-suspended);
            font-size: 0.875rem;
            margin-top: 0.5rem;
        }
        
        .btn-danger {
            background: linear-gradient(135deg, var(--status-suspended) 0%, #dc2626 100%);
            color: white;
        }
        
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: var(--merchant-shadow-lg);
        }
        
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            color: white;
        }
        
        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-top: 4px solid white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 1rem;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 10000;
        }
        
        /* 多付款账户样式 */
        .form-section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        
        .payment-accounts-list {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }
        
        .payment-account-item {
            padding: 1.5rem;
            border: 2px solid var(--dashboard-border-light);
            border-radius: 12px;
            background: var(--dashboard-bg-primary);
            transition: all 0.3s ease;
            position: relative;
        }
        
        .payment-account-item:hover {
            border-color: var(--dashboard-primary-light);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.1);
        }
        
        .account-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--dashboard-border-light);
        }
        
        .account-item-title {
            margin: 0;
            color: var(--dashboard-primary);
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .account-item-title::before {
            content: "💳";
            font-size: 0.875rem;
        }
        
        .remove-account-btn {
            background: transparent;
            border: 1px solid var(--status-suspended);
            color: var(--status-suspended);
            padding: 0.375rem 0.75rem;
            border-radius: 6px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }
        
        .remove-account-btn:hover {
            background: var(--status-suspended);
            color: white;
            transform: translateY(-1px);
        }
        
        .remove-account-btn .btn__icon {
            font-size: 0.75rem;
        }
        
        .bank-name-row {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px dashed var(--dashboard-border-light);
        }
        
        .manual-bank-group {
            margin-top: 0.75rem;
        }
        
        /* 小屏幕适配 */
        @media (max-width: 768px) {
            .form-section-header {
                flex-direction: column;
                align-items: stretch;
                gap: 1rem;
            }
            
            .payment-account-item {
                padding: 1rem;
            }
            
            .account-item-header {
                flex-direction: column;
                align-items: stretch;
                gap: 0.75rem;
            }
            
            .account-item-title {
                text-align: center;
            }
            
            .remove-account-btn {
                align-self: center;
                width: fit-content;
            }
        }
        
        /* 轮询配置模态框样式 */
        .receiving-account-item {
            padding: 1.5rem;
            border: 2px solid var(--dashboard-border-light);
            border-radius: 12px;
            background: var(--dashboard-bg-primary);
            transition: all 0.3s ease;
            position: relative;
            margin-bottom: 1rem;
        }
        
        .receiving-account-item:hover {
            border-color: var(--dashboard-primary-light);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.1);
        }
        
        .receiving-account-item .account-item-title::before {
            content: "🏦";
            font-size: 0.875rem;
        }
        
        /* 单选按钮组样式 */
        .radio-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
            margin-top: 0.75rem;
        }
        
        .radio-label {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            cursor: pointer;
            padding: 1rem;
            border: 2px solid var(--dashboard-border-light);
            border-radius: 8px;
            background: var(--dashboard-bg-secondary);
            transition: all 0.2s ease;
        }
        
        .radio-label:hover {
            border-color: var(--dashboard-primary-light);
            background: var(--dashboard-bg-primary);
        }
        
        .radio-label input[type="radio"] {
            display: none;
        }
        
        .radio-custom {
            width: 20px;
            height: 20px;
            border: 2px solid var(--dashboard-border-medium);
            border-radius: 50%;
            background: var(--dashboard-bg-primary);
            position: relative;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }
        
        .radio-label input[type="radio"]:checked + .radio-custom {
            border-color: var(--dashboard-primary);
            background: var(--dashboard-primary);
        }
        
        .radio-label input[type="radio"]:checked + .radio-custom::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: white;
        }
        
        .radio-text {
            flex: 1;
            color: var(--dashboard-text-primary);
        }
        
        .radio-text strong {
            display: block;
            margin-bottom: 0.25rem;
            color: var(--dashboard-primary);
        }
        
        .radio-text small {
            color: var(--dashboard-text-muted);
            font-size: 0.8rem;
        }
        
        /* 复选框组样式优化 */
        .checkbox-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.75rem;
            margin-top: 0.75rem;
        }
        
        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            padding: 0.75rem;
            border-radius: 6px;
            transition: background-color 0.2s ease;
        }
        
        .checkbox-label:hover {
            background: var(--dashboard-bg-tertiary);
        }
        
        .checkbox-label input[type="checkbox"] {
            display: none;
        }
        
        .checkbox-custom {
            width: 18px;
            height: 18px;
            border: 2px solid var(--dashboard-border-medium);
            border-radius: 3px;
            background: var(--dashboard-bg-secondary);
            position: relative;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }
        
        .checkbox-label input[type="checkbox"]:checked + .checkbox-custom {
            background: var(--dashboard-primary);
            border-color: var(--dashboard-primary);
        }
        
        .checkbox-label input[type="checkbox"]:checked + .checkbox-custom::after {
            content: '✓';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-size: 12px;
            font-weight: bold;
        }
        
        .checkbox-text {
            color: var(--dashboard-text-primary);
            font-size: 0.9rem;
            font-weight: 500;
        }
        
        /* 预览样式 */
        .config-preview {
            padding: 1rem;
        }
        
        .preview-section {
            margin-bottom: 1.5rem;
            padding: 1rem;
            background: var(--dashboard-bg-secondary);
            border-radius: 8px;
        }
        
        .preview-section h4 {
            margin: 0 0 1rem 0;
            color: var(--dashboard-primary);
            font-size: 1rem;
            border-bottom: 1px solid var(--dashboard-border-light);
            padding-bottom: 0.5rem;
        }
        
        .preview-section p {
            margin: 0.5rem 0;
            font-size: 0.9rem;
        }
        
        .account-preview {
            background: var(--dashboard-bg-primary);
            padding: 0.75rem;
            border-radius: 6px;
            margin-bottom: 0.5rem;
            border-left: 3px solid var(--dashboard-primary);
        }
        
        .account-preview p {
            margin: 0.25rem 0;
        }
        
        /* 小屏幕适配 */
        @media (max-width: 768px) {
            .radio-group {
                grid-template-columns: 1fr;
            }
            
            .checkbox-group {
                grid-template-columns: 1fr;
            }
            
            .radio-label {
                padding: 0.75rem;
            }
            
            .checkbox-label {
                padding: 0.5rem;
            }
        }
    </style>
</body>
</html>