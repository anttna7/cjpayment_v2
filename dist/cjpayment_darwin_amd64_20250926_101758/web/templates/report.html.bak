    <!-- Critical Scripts - Load immediately -->
    <script src="/static/js/utils.js"></script>
    <script src="/static/js/api.js"></script>
    <script src="/static/js/components.js"></script>
    
    <!-- Header Interaction - 修复头部导航交互 -->
    <script src="/static/js/header-interaction.js"></script>
    
    <!-- Unified Header System - 统一头部系统 -->
    <script src="/static/js/header-unified.js"></script>
    
    <!-- Main Report Dashboard Script -->
    <script src="/static/js/report_dashboard.js?v=1.5"></script>
    
    <!-- Advanced Data Table Script -->
    <script src="/static/js/advanced-data-table.js"></script>
    
    <!-- Non-critical Scripts - Load asynchronously -->
    <script async src="/static/js/user-feedback-analytics.js"></script>
    <script async src="/static/js/analytics-init.js"></script>
    <script async src="/static/js/mobile-utilities.js"></script>
    <script async src="/static/js/interaction-enhancements.js"></script>
    
    <!-- Initialize Report Enhanced -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 延迟初始化以确保所有依赖都已加载
            setTimeout(function() {
                initializeReportSystem();
            }, 100);
        });

        function initializeReportSystem() {
            // Check dependencies with retry mechanism
            const dependencies = ['CJUtils', 'CJApi', 'CJComponents', 'ReportDashboard'];
            const missing = dependencies.filter(dep => typeof window[dep] === 'undefined');
            
            if (missing.length > 0) {
                console.warn('Missing dependencies:', missing);
                
                // 重试机制
                if (missing.includes('ReportDashboard')) {
                    setTimeout(initializeReportSystem, 200);
                    return;
                }
                
                // 如果其他依赖缺失，使用基础版本
                console.log('Using basic report initialization');
                initializeBasicReport();
                return;
            }
            
            try {
                // Initialize enhanced report system
                window.reportManager = new ReportDashboard({
                    apiEndpoint: '/api/reports',
                    enableRealTime: true,
                    autoRefresh: 60000,
                    enableAdvancedAnalytics: true
                });
                
                // Initialize advanced data table
                if (typeof AdvancedDataTable !== 'undefined') {
                    window.advancedTable = new AdvancedDataTable({
                        containerId: 'advancedDataTableContainer',
                        apiEndpoint: '/api/transactions',
                        pageSize: 50,
                        defaultView: 'table',
                        enableSearch: true,
                        enableFilters: true,
                        enableSorting: true,
                        autoRefresh: false
                    });
                    console.log('高级数据表初始化成功');
                }
                
                console.log('Enhanced report system initialized successfully');
            } catch (error) {
                console.error('Failed to initialize enhanced report system:', error);
                // 降级到基础版本
                initializeBasicReport();
            }
        }

        function initializeBasicReport() {
            console.log('Initializing basic report functionality');
            // 基础功能初始化
            const refreshBtn = document.getElementById('refreshReportBtn');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', function() {
                    location.reload();
                });
            }
        }

        // Initialize Report Page
        document.addEventListener('DOMContentLoaded', function() {
            // 初始化统一头部组件
            window.headerUnified = new HeaderUnified();
        });

        // 模态框管理函数
        function showModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.style.display = 'flex';
                setTimeout(() => {
                    modal.classList.add('show');
                }, 10);
            }
        }

        function hideModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.remove('show');
                setTimeout(() => {
                    modal.style.display = 'none';
                }, 300);
            }
        }

        function closeExportModal() {
            hideModal('exportModal');
        }

        function closeSubscriptionModal() {
            hideModal('subscriptionModal');
        }

        // 点击背景关闭模态框
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('modal-enhanced')) {
                const modalId = e.target.id;
                hideModal(modalId);
            }
        });

        // 绑定关闭按钮事件
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.modal-close').forEach(button => {
                button.addEventListener('click', function() {
                    const modal = this.closest('.modal-enhanced');
                    if (modal) {
                        hideModal(modal.id);
                    }
                });
            });
        });
    </script>

    <!-- Additional Styles for Report Page -->
    <style>
        .time-range-selector {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        
        .time-presets {
