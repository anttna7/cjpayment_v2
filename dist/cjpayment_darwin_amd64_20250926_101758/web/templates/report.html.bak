            font-weight: 600;
            color: var(--dashboard-text-primary, #1a1a1a);
        }
        
        .page__subtitle {
            margin: 0;
            color: var(--dashboard-text-secondary, #6c757d);
            font-size: 0.875rem;
        }
        
        .page__actions {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            align-items: flex-end;
        }
        
        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.5rem;
        }
        
        .kpi-dashboard {
            margin-bottom: 2rem;
        }
        
        .report-grid {
            display: grid;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .chart-container {
            background: var(--dashboard-bg-primary, #fff);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
        
        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--dashboard-border-light, #e9ecef);
        }
        
        .chart-title {
