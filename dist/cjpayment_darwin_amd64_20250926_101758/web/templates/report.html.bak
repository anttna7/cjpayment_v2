<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>数据报表中心 - CJPayment 企业内部支付管理系统</title>
    
    <!-- Preload critical resources -->
    <link rel="preload" href="/static/css/report_dashboard.css" as="style">
    <link rel="preload" href="/static/js/utils.js" as="script">
    <link rel="preload" href="/static/js/api.js" as="script">
    <link rel="preload" href="/static/js/components.js" as="script">
    
    <!-- 统一主题系统 -->
    <link rel="stylesheet" href="/static/css/theme-unified.css">
    <link rel="stylesheet" href="/static/css/header-unified.css">
    
    <!-- 统一布局样式系统 -->
    <link rel="stylesheet" href="/static/css/layout-unified.css">
    
    <!-- Header Dropdown 修复 - 解决通知和用户菜单默认打开状态问题 -->
    <link rel="stylesheet" href="/static/css/header-dropdown-fix.css">
    
    <!-- 统一按钮交互样式系统 -->
    <link rel="stylesheet" href="/static/css/buttons-unified.css">
    
    <!-- 页面特定样式 -->
    <link rel="stylesheet" href="/static/css/report_dashboard.css">
    <link rel="stylesheet" href="/static/css/advanced-data-table.css">
    
    <!-- DNS预连接优化 -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    
    <!-- External Chart Libraries - 高优先级异步加载 -->
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js" as="script">
    <script async src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
    <script async src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    
    <!-- Fast Loader - 快速加载器 (替代原性能优化器) -->
    <script src="/static/js/report-fast-loader.js"></script>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    
    <!-- Meta tags -->
    <meta name="description" content="CJPayment企业内部支付管理系统数据报表中心">
    <meta name="keywords" content="数据报表,数据可视化,统计分析,支付管理">
</head>
<body class="page-report-enhanced">
    <!-- Enhanced Navigation Header -->
    <header class="app__header" id="appHeader">
        <div class="header">
            <!-- Logo Section -->
            <div class="header__left">
                <a href="/dashboard" class="logo">
                    <div class="logo__icon">💎</div>
                    <div>
                        <h1 class="logo__text">CJPayment</h1>
                        <span class="logo__version">v2.0</span>
                    </div>
                </a>
            </div>
            
            <!-- Main Navigation -->
            <nav class="nav" id="headerNav" role="navigation" aria-label="主要导航">
                <ul class="nav__list">
                    <li class="nav__item">
                        <a href="/dashboard" class="nav__link" data-route="dashboard">
                            <span class="nav__icon">📊</span>
                            <span class="nav__text">仪表板</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/merchant" class="nav__link" data-route="merchant">
                            <span class="nav__icon">🏪</span>
                            <span class="nav__text">商户管理</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/accounts" class="nav__link" data-route="accounts">
                            <span class="nav__icon">💰</span>
                            <span class="nav__text">账户管理</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/audit" class="nav__link" data-route="audit">
                            <span class="nav__icon">📋</span>
                            <span class="nav__text">财务审核</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/reports" class="nav__link nav__link--active" data-route="reports">
                            <span class="nav__icon">📈</span>
                            <span class="nav__text">数据报表</span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/system_management" class="nav__link" data-route="system">
                            <span class="nav__icon">⚙️</span>
                            <span class="nav__text">系统管理</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <!-- Header Right -->
            <div class="header__right">
                <!-- Theme Toggle -->
                <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
                    <span class="theme-icon">🌙</span>
                </button>
                
                <!-- Notifications -->
                <div class="notifications" id="notifications">
                    <button class="notifications__trigger" id="notificationButton" aria-label="通知" title="查看通知">
                        <span class="notifications__icon">🔔</span>
                        <span class="notifications__badge" id="notificationBadge">3</span>
                    </button>
                    <div class="notifications__dropdown" id="notificationsDropdown">
                        <div class="notifications__header">
                            <h4>商户通知</h4>
                            <button class="notifications__clear" id="clearNotifications">全部已读</button>
                        </div>
                        <div class="notifications__list" id="notificationsList">
                            <div class="notification-item notification-unread">
                                <div class="notification-icon unread"></div>
                                <div class="notification-content">
                                    <div class="notification-title">新商户待审核</div>
                                    <div class="notification-text">有2个新商户申请待审核</div>
                                    <div class="notification-meta">
                                        <span class="notification-time">10分钟前</span>
                                        <span class="notification-new">新</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- User Menu -->
                <div class="user-menu" id="userMenu">
                    <button class="user-menu__trigger" id="userButton">
                        <div class="user-menu__avatar">👤</div>
                        <div class="user-menu__info">
                            <span class="user-menu__name">管理员</span>
                            <span class="user-menu__role">超级管理员</span>
                        </div>
                        <span class="user-menu__arrow">▼</span>
                    </button>
                    <div class="user-menu__dropdown" id="userDropdown">
                        <a href="/profile" class="user-menu__item">
                            <span class="user-menu__item-icon">👤</span>
                            个人资料
                        </a>
                        <a href="/settings" class="user-menu__item">
                            <span class="user-menu__item-icon">⚙️</span>
                            账户设置
                        </a>
                        <div class="user-menu__divider"></div>
                        <a href="/logout" class="user-menu__item user-menu__item--danger">
                            <span class="user-menu__item-icon">🚪</span>
                            退出登录
                        </a>
                    </div>
                </div>
                
                <button class="nav__toggle" id="mobileMenuToggle">
                    <span class="nav__toggle-line"></span>
                    <span class="nav__toggle-line"></span>
                    <span class="nav__toggle-line"></span>
                </button>
            </div>
            </div>
        </div>
    </header>

    <!-- Enhanced Main Content -->
    <main class="app__main" id="appMain">
        <div class="dashboard-container">
            <!-- Enhanced Header -->
            <div class="page__header">
                <div class="page__title">
                    <h1>数据报表中心</h1>
                    <p class="page__subtitle">智能数据分析与可视化报表展示</p>
                </div>
                
                <div class="page__actions">
                    <!-- Time Range Selector -->
                    <div class="time-range-selector">
                        <div class="time-presets">
                            <button class="btn btn--sm time-preset active" data-range="today">今天</button>
                            <button class="btn btn--sm time-preset" data-range="yesterday">昨天</button>
                            <button class="btn btn--sm time-preset" data-range="week">本周</button>
                            <button class="btn btn--sm time-preset" data-range="month">本月</button>
                            <button class="btn btn--sm time-preset" data-range="quarter">本季</button>
                            <button class="btn btn--sm time-preset" data-range="custom">自定义</button>
                        </div>
                        <div class="custom-range" id="customRange" style="display: none;">
                            <input type="date" id="startDate" class="form-input form-input--sm">
                            <span class="date-separator">至</span>
                            <input type="date" id="endDate" class="form-input form-input--sm">
                        </div>
                    </div>

                    <!-- Advanced Filters -->
                    <div class="advanced-filters" id="advancedFilters">
                        <button class="btn btn--sm btn-outline" id="toggleAdvancedFilters">
                            <span class="btn__icon">🔍</span>
                            <span class="btn__text">高级筛选</span>
                            <span class="btn__arrow">▼</span>
                        </button>
                        <div class="advanced-filters-panel" id="advancedFiltersPanel" style="display: none;">
                            <div class="filter-row">
                                <div class="filter-group">
                                    <label class="filter-label">商户类型</label>
                                    <select class="filter-select" id="merchantTypeFilter">
                                        <option value="">全部类型</option>
                                        <option value="enterprise">企业</option>
                                        <option value="individual">个体</option>
                                        <option value="platform">平台</option>
                                    </select>
                                </div>
                                <div class="filter-group">
                                    <label class="filter-label">交易状态</label>
                                    <select class="filter-select" id="transactionStatusFilter">
                                        <option value="">全部状态</option>
                                        <option value="success">成功</option>
                                        <option value="failed">失败</option>
                                        <option value="pending">处理中</option>
                                        <option value="cancelled">已取消</option>
                                    </select>
                                </div>
                                <div class="filter-group">
                                    <label class="filter-label">金额范围</label>
                                    <select class="filter-select" id="amountRangeFilter">
                                        <option value="">全部金额</option>
                                        <option value="small">小额 (< ¥1,000)</option>
                                        <option value="medium">中额 (¥1,000 - ¥10,000)</option>
                                        <option value="large">大额 (> ¥10,000)</option>
                                    </select>
                                </div>
                                <div class="filter-group">
                                    <label class="filter-label">支付方式</label>
                                    <select class="filter-select" id="paymentMethodFilter">
                                        <option value="">全部方式</option>
                                        <option value="bank_card">银行卡</option>
                                        <option value="alipay">支付宝</option>
                                        <option value="wechat">微信支付</option>
                                        <option value="other">其他</option>
                                    </select>
                                </div>
                            </div>
                            <div class="filter-actions">
                                <button class="btn btn--sm btn-primary" id="applyAdvancedFilters">
                                    <span class="btn__icon">✓</span>
                                    <span class="btn__text">应用筛选</span>
                                </button>
                                <button class="btn btn--sm btn-outline" id="resetAdvancedFilters">
                                    <span class="btn__icon">🔄</span>
                                    <span class="btn__text">重置</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="action-group">
                        <button class="btn btn-outline" id="refreshReportBtn">
                            <span class="btn__icon">🔄</span>
                            <span class="btn__text">刷新数据</span>
                        </button>
                        <button class="btn btn-success" id="exportReportBtn">
                            <span class="btn__icon">📊</span>
                            <span class="btn__text">导出报表</span>
                        </button>
                        <button class="btn btn-primary" id="subscribeReportBtn">
                            <span class="btn__icon">📧</span>
                            <span class="btn__text">订阅报表</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Enhanced KPI Dashboard -->
            <div class="kpi-dashboard">
                <div class="kpi-card kpi-card--primary">
                    <div class="kpi-header">
                        <div class="kpi-icon">💰</div>
                        <div class="kpi-trend" id="totalAmountTrend">
                            <span class="trend-icon">📈</span>
                            <span class="trend-text">+12.5%</span>
                        </div>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-value" id="totalAmount">
                            <span class="kpi-number">¥2,856,742.30</span>
                        </div>
                        <div class="kpi-label">总交易额</div>
                        <div class="kpi-sparkline">
                            <canvas id="totalAmountSparkline" class="sparkline-canvas"></canvas>
                        </div>
                    </div>
                </div>

                <div class="kpi-card kpi-card--success">
                    <div class="kpi-header">
                        <div class="kpi-icon">📊</div>
                        <div class="kpi-trend" id="totalTransactionsTrend">
                            <span class="trend-icon">📈</span>
                            <span class="trend-text">+8.3%</span>
                        </div>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-value" id="totalTransactions">
                            <span class="kpi-number">1,247</span>
                            <span class="kpi-unit">笔</span>
                        </div>
                        <div class="kpi-label">交易笔数</div>
                        <div class="kpi-sparkline">
                            <canvas id="totalTransactionsSparkline" class="sparkline-canvas"></canvas>
                        </div>
                    </div>
                </div>

                <div class="kpi-card kpi-card--warning">
                    <div class="kpi-header">
                        <div class="kpi-icon">✅</div>
                        <div class="kpi-trend" id="successRateTrend">
                            <span class="trend-icon">📈</span>
                            <span class="trend-text">+2.1%</span>
                        </div>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-value" id="successRate">
                            <span class="kpi-number">98.7</span>
                            <span class="kpi-unit">%</span>
                        </div>
                        <div class="kpi-label">成功率</div>
                        <div class="kpi-sparkline">
                            <canvas id="successRateSparkline" class="sparkline-canvas"></canvas>
                        </div>
                    </div>
                </div>

                <div class="kpi-card kpi-card--info">
                    <div class="kpi-header">
                        <div class="kpi-icon">⏱️</div>
                        <div class="kpi-trend" id="avgProcessTimeTrend">
                            <span class="trend-icon">📉</span>
                            <span class="trend-text">-15.4%</span>
                        </div>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-value" id="avgProcessTime">
                            <span class="kpi-number">2.3</span>
                            <span class="kpi-unit">秒</span>
                        </div>
                        <div class="kpi-label">平均处理时间</div>
                        <div class="kpi-sparkline">
                            <canvas id="avgProcessTimeSparkline" class="sparkline-canvas"></canvas>
                        </div>
                    </div>
                </div>

                <div class="kpi-card kpi-card--secondary">
                    <div class="kpi-header">
                        <div class="kpi-icon">🏪</div>
                        <div class="kpi-trend" id="activeMerchantsTrend">
                            <span class="trend-icon">📈</span>
                            <span class="trend-text">+3</span>
                        </div>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-value" id="activeMerchants">
                            <span class="kpi-number">128</span>
                            <span class="kpi-unit">个</span>
                        </div>
                        <div class="kpi-label">活跃商户</div>
                        <div class="kpi-sparkline">
                            <canvas id="activeMerchantsSparkline" class="sparkline-canvas"></canvas>
                        </div>
                    </div>
                </div>

                <div class="kpi-card kpi-card--danger">
                    <div class="kpi-header">
                        <div class="kpi-icon">⚠️</div>
                        <div class="kpi-trend" id="failedTransactionsTrend">
                            <span class="trend-icon">📉</span>
                            <span class="trend-text">-25%</span>
                        </div>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-value" id="failedTransactions">
                            <span class="kpi-number">16</span>
                            <span class="kpi-unit">笔</span>
                        </div>
                        <div class="kpi-label">失败交易</div>
                        <div class="kpi-sparkline">
                            <canvas id="failedTransactionsSparkline" class="sparkline-canvas"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Advanced Charts Grid -->
            <div class="charts-container">
                <!-- Transaction Trend Analysis -->
                <div class="chart-card chart-card--expanded">
                    <div class="chart-header">
                        <div class="chart-title-section">
                            <h3 class="chart-title">📈 交易趋势分析</h3>
                            <p class="chart-subtitle">多维度交易数据趋势展示</p>
                        </div>
                        <div class="chart-controls">
                            <div class="chart-tabs">
                                <button class="chart-tab active" data-tab="amount">金额</button>
                                <button class="chart-tab" data-tab="count">笔数</button>
                                <button class="chart-tab" data-tab="rate">成功率</button>
                            </div>
                            <div class="chart-actions">
                                <button class="chart-action-btn" title="全屏显示" data-action="fullscreen">
                                    <span class="icon">⛶</span>
                                </button>
                                <button class="chart-action-btn" title="导出图表" data-action="export">
                                    <span class="icon">📊</span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="chart-body">
                        <div class="chart-container chart-container--expanded">
                            <canvas id="trendChart" class="chart-canvas"></canvas>
                            <div class="chart-loading" id="trendChartLoading">
                                <div class="loading-spinner"></div>
                                <span class="loading-text">加载图表中...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Merchants Performance -->
                <div class="chart-card chart-card--expanded">
                    <div class="chart-header">
                        <div class="chart-title-section">
                            <h3 class="chart-title">🏆 商户表现排行</h3>
                            <p class="chart-subtitle">Top 10 商户数据对比</p>
                        </div>
                        <div class="chart-controls">
                            <select class="chart-select" id="merchantSortBy">
                                <option value="amount">按金额</option>
                                <option value="count">按笔数</option>
                                <option value="success_rate">按成功率</option>
                            </select>
                        </div>
                    </div>
                    <div class="chart-body">
                        <div class="chart-container chart-container--expanded">
                            <canvas id="merchantChart" class="chart-canvas"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Time-based Heatmap -->
                <div class="chart-card chart-card--full-width">
                    <div class="chart-header">
                        <div class="chart-title-section">
                            <h3 class="chart-title">🔥 时段活跃度热力图</h3>
                            <p class="chart-subtitle">24小时×7天交易热力分布</p>
                        </div>
                        <div class="chart-controls">
                            <select class="chart-select" id="heatmapMetric">
                                <option value="transaction_count">交易笔数</option>
                                <option value="transaction_amount">交易金额</option>
                                <option value="success_rate">成功率</option>
                            </select>
                        </div>
                    </div>
                    <div class="chart-body">
                        <div class="heatmap-container heatmap-container--expanded" id="heatmapChart"></div>
                    </div>
                </div>



            </div>

            <!-- Advanced Data Table -->
            <div class="advanced-data-table-container" id="advancedDataTableContainer">
                <div class="table-header-advanced">
                    <div class="table-title-section">
                        <h3 class="table-title">📊 高级数据表</h3>
                        <p class="table-subtitle">多维度交易数据分析与管理</p>
                    </div>
                    
                    <!-- Table Toolbar -->
                    <div class="table-toolbar">
                        <div class="toolbar-left">
                            <div class="table-search-advanced">
                                <div class="search-input-container">
                                    <input type="text" id="advancedTableSearch" class="search-input-advanced" placeholder="全文搜索...">
                                    <button class="search-btn-advanced" id="searchBtn">🔍</button>
                                    <button class="search-clear-btn" id="clearSearchBtn" style="display: none;">✕</button>
                                </div>
                                <div class="search-suggestions" id="searchSuggestions" style="display: none;">
                                    <!-- 搜索建议动态生成 -->
                                </div>
                            </div>
                            
                            <div class="quick-filters">
                                <button class="quick-filter-btn active" data-filter="all">全部</button>
                                <button class="quick-filter-btn" data-filter="today">今日</button>
                                <button class="quick-filter-btn" data-filter="success">成功</button>
                                <button class="quick-filter-btn" data-filter="failed">失败</button>
                                <button class="quick-filter-btn" data-filter="large">大额</button>
                            </div>
                        </div>
                        
                        <div class="toolbar-right">
                            <div class="table-view-controls">
                                <div class="view-toggle-group">
                                    <button class="view-toggle-btn active" data-view="table">📋</button>
                                    <button class="view-toggle-btn" data-view="cards">📊</button>
                                    <button class="view-toggle-btn" data-view="timeline">📅</button>
                                </div>
                                
                                <div class="table-density-control">
                                    <button class="density-btn" data-density="compact" title="紧凑视图">⚌</button>
                                    <button class="density-btn active" data-density="default" title="默认视图">☰</button>
                                    <button class="density-btn" data-density="spacious" title="宽松视图">≡</button>
                                </div>
                            </div>
                            
                            <div class="table-actions-advanced">
                                <button class="btn-enhanced btn-sm btn-outline" id="advancedFiltersToggle">
                                    <span class="btn__icon">🔧</span>
                                    高级筛选
                                </button>
                                <button class="btn-enhanced btn-sm btn-outline" id="columnSettingsBtn">
                                    <span class="btn__icon">⚙️</span>
                                    列设置
                                </button>
                                <button class="btn-enhanced btn-sm btn-outline" id="refreshAdvancedTableBtn">
                                    <span class="btn__icon">🔄</span>
                                    刷新
                                </button>
                                <div class="dropdown-wrapper">
                                    <button class="btn-enhanced btn-sm btn-success dropdown-trigger" id="exportAdvancedBtn">
                                        <span class="btn__icon">📤</span>
                                        导出
                                        <span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="dropdown-menu" id="exportDropdownMenu">
                                        <a class="dropdown-item" href="#" data-export="current">导出当前页</a>
                                        <a class="dropdown-item" href="#" data-export="filtered">导出筛选结果</a>
                                        <a class="dropdown-item" href="#" data-export="all">导出全部数据</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="#" data-export="template">下载模板</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Advanced Filters Panel -->
                    <div class="advanced-filters-panel" id="advancedFiltersPanel" style="display: none;">
                        <div class="filters-header">
                            <h4 class="filters-title">高级筛选条件</h4>
                            <button class="filters-close-btn" id="closeAdvancedFilters">✕</button>
