            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .time-preset.active {
            background: var(--dashboard-primary, #007bff);
            color: white;
        }
        
        .custom-range {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem;
            background: var(--dashboard-bg-secondary, #f8f9fa);
            border-radius: 6px;
        }
        
        .date-separator {
            color: var(--dashboard-text-secondary, #6c757d);
